    // --- 7. POLICY ENFORCING TOOL EXECUTOR INTEGRATION ---

    @Test
    fun testPolicyEnforcerRejectionPreventsExecution() = runBlocking {
        val mock = MockToolExecutor()
        val approver = UiCommandApprover()
        val enforcer = PolicyEnforcingToolExecutor(
            delegate = mock,
            approver = approver,
            initialPermissions = SecurityPermissions(allowReadFile = true),
            initialPreset = SecurityPreset.REQUEST_REVIEW,
            workspaceRoot = workspaceDir,
        )

        // Launch execution in background coroutine - it will suspend waiting for approval
        val job = kotlinx.coroutines.launch {
            val call = ToolCall(id = "call_1", name = "read_file", arguments = """{"path":"sample.txt"}""")
            val result = enforcer.execute(call)
            assertFalse(result.isSuccess)
            assertTrue(result.content.contains("rejected by user", ignoreCase = true))
        }

        // Wait for approval request to be posted
        var pendingId: String? = null
        for (i in 0 until 50) {
            val pending = approver.pendingApprovals.value
            if (pending.isNotEmpty()) {
                pendingId = pending.first().id
                break
            }
            kotlinx.coroutines.delay(20)
        }

        assertTrue(pendingId != null, "Pending approval must be created")
        approver.reject(pendingId!!)
        job.join()
        assertEquals(0, mock.calls.size, "Delegate executor must NEVER be called when request is rejected")
    }

    @Test
    fun testPolicyEnforcerApprovalAllowsExecution() = runBlocking {
        val mock = MockToolExecutor()
        mock.registerResult("read_file", "file contents")
        val approver = UiCommandApprover()
        val enforcer = PolicyEnforcingToolExecutor(
            delegate = mock,
