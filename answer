    internal fun parseGitConfigContent(
        content: String,
        baseDir: Path? = null,
        visited: MutableSet<Path> = mutableSetOf(),
        depth: Int = 0,
    ): Pair<Map<String, String>, Boolean> {
        val result = mutableMapOf<String, String>()
        var currentSection = ""
        var hasUnresolvedInclude = false

        for (rawLine in content.lines()) {
            val line = rawLine.trim()
            if (line.isEmpty() || line.startsWith("#") || line.startsWith(";")) continue
            if (line.startsWith("[") && line.endsWith("]")) {
                val sectionContent = line.substring(1, line.length - 1).trim()
                if (sectionContent.contains('"')) {
                    val secName = sectionContent.substringBefore('"').trim().lowercase(Locale.ROOT)
                    val subSec = sectionContent.substringAfter('"').substringBeforeLast('"').trim()
                    currentSection = "$secName.$subSec"
                } else {
                    currentSection = sectionContent.lowercase(Locale.ROOT)
                }
                continue
            }
            if (line.contains("=")) {
                val key = line.substringBefore("=").trim().lowercase(Locale.ROOT)
                val value = line.substringAfter("=").trim()
                val fullKey = if (currentSection.isNotEmpty()) "$currentSection.$key" else key
                result[fullKey] = value

                if (fullKey == "include.path" || (fullKey.startsWith("includeif.") && fullKey.endsWith(".path"))) {
                    val incPathStr = value.removeSurrounding("\"").removeSurrounding("'").trim()
                    if (incPathStr.isNotEmpty() && depth < 10) {
