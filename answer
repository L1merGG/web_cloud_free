                                incPathStr.startsWith("~/") -> {
                                    val home = System.getProperty("user.home") ?: ""
                                    if (home.isNotBlank()) Path.of(home, incPathStr.removePrefix("~/")) else null
                                }
                                Path.of(incPathStr).isAbsolute -> Path.of(incPathStr)
                                baseDir != null -> baseDir.resolve(incPathStr).normalize()
                                else -> null
                            }

                            if (targetPath != null && Files.isRegularFile(targetPath)) {
                                val norm = targetPath.toAbsolutePath().normalize()
                                if (norm !in visited) {
                                    visited.add(norm)
                                    val subContent = Files.readString(norm)
                                    val (subEntries, subUnres) = parseGitConfigContent(subContent, norm.parent, visited, depth + 1)
                                    result.putAll(subEntries)
                                    if (subUnres) hasUnresolvedInclude = true
                                }
                            } else {
                                hasUnresolvedInclude = true
                            }
                        } catch (_: Exception) {
                            hasUnresolvedInclude = true
                        }
                    } else if (incPathStr.isNotEmpty()) {
                        hasUnresolvedInclude = true
                    }
                }
            }
        }
        return Pair(result, hasUnresolvedInclude)
