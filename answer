        public async Task<TurnContentResult> ExtractLatestTurnContentAsync(int timeoutMs = 5000)
        {
            EnsureInitialized();

            const string script = @"(() => {
                // Find all model response elements
                const selectors = [
                    'model-response',
                    '.model-response',
                    '[data-message-author=""model""]',
                    '.response-container-content',
                    'message-content'
                ];

                let candidates = [];
                for (const sel of selectors) {
                    const elements = document.querySelectorAll(sel);
                    if (elements.length > 0) {
                        candidates = Array.from(elements);
                        break;
                    }
                }

                if (candidates.length === 0) {
                    return JSON.stringify({
                        turnIndex: -1,
                        text: '',
                        html: '',
                        isComplete: false
                    });
                }

                // Filter out any nested containers to ensure we only count top-level turns
                const topLevelTurns = candidates.filter(el => {
                    for (const other of candidates) {
                        if (other !== el && other.contains(el)) return false;
                    }
                    return true;
                });

                if (topLevelTurns.length === 0) {
                    return JSON.stringify({
                        turnIndex: -1,
                        text: '',
                        html: '',
                        isComplete: false
                    });
                }

                const latestIndex = topLevelTurns.length - 1;
                const latest = topLevelTurns[latestIndex];

                // Text extraction
                const text = latest.innerText || latest.textContent || '';
                const html = latest.innerHTML || '';

                // Check completeness
                const isComplete = !document.querySelector('button[aria-label*=""Stop""], button[aria-label*=""Остановить""]');

                return JSON.stringify({
                    turnIndex: latestIndex,
                    text: text.trim(),
                    html: html.trim(),
                    isComplete: isComplete
                });
            })()";

            var jsonResult = await EvaluateScriptUnwrappedAsync(script, timeoutMs);
            if (string.IsNullOrEmpty(jsonResult))
            {
                return new TurnContentResult { TurnIndex = -1, Text = "", Html = "", IsComplete = false };
            }

            try
            {
                return JsonSerializer.Deserialize<TurnContentResult>(jsonResult, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }) ?? new TurnContentResult();
            }
            catch (Exception ex)
            {
                _logCallback("Failed to parse TurnContent JSON", new { error = ex.Message });
                return new TurnContentResult { TurnIndex = -1, Text = "", Html = "", IsComplete = false };
            }
        }

        public async Task<bool> SendPromptAsync(string promptText, int timeoutMs = 15000)
        {
            EnsureInitialized();

            _logCallback("Sending prompt to Gemini...", new { promptLength = promptText.Length });

            var escapedPrompt = JsonSerializer.Serialize(promptText);

            var script = $@"(() => {{
                const text = {escapedPrompt};

                // Find input element
                const inputSelectors = [
                    'rich-textarea .ql-editor',
                    'rich-textarea p',
                    'div[contenteditable=""true""]',
                    'textarea'
                ];

                let inputEl = null;
                for (const sel of inputSelectors) {
                    const el = document.querySelector(sel);
                    if (el && el.offsetParent !== null) {
                        inputEl = el;
                        break;
                    }
                }

                if (!inputEl) return JSON.stringify({{ success: false, error: 'input_not_found' }});

                // Focus and clear/set text
                inputEl.focus();

                if (inputEl.tagName.toLowerCase() === 'textarea') {{
                    inputEl.value = text;
                    inputEl.dispatchEvent(new Event('input', {{ bubbles: true }}));
                    inputEl.dispatchEvent(new Event('change', {{ bubbles: true }}));
                }} else {{
                    // Contenteditable (ProseMirror / Quill)
                    inputEl.innerHTML = '';
                    const p = document.createElement('p');
                    p.textContent = text;
                    inputEl.appendChild(p);

                    inputEl.dispatchEvent(new InputEvent('input', {{
                        bubbles: true,
                        cancelable: true,
                        inputType: 'insertText',
                        data: text
                    }}));
                }}

                // Wait shortly and click send button
                return JSON.stringify({{ success: true }});
            }})()";

            var setupResultJson = await EvaluateScriptUnwrappedAsync(script, timeoutMs);
            _logCallback("Input text set result", new { result = setupResultJson });

            // Small delay for UI state update
            await Task.Delay(300);

            // Now click the send button
            const string clickScript = @"(() => {
                const sendSelectors = [
                    'button[aria-label*=""Send""]',
                    'button[aria-label*=""Отправить""]',
                    'button.send-button',
