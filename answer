    private fun evaluateExecuteCommand(
        call: ToolCall,
        permissions: SecurityPermissions,
        preset: SecurityPreset,
        workspaceRoot: Path,
        env: Map<String, String> = System.getenv(),
        userConfigPath: Path? = null,
        systemConfigPath: Path? = null,
    ): SecurityDecision {
        if (!permissions.allowExecuteCommand) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Executing terminal commands is disabled in security permissions",
            )
        }

        val cmd = try {
            TerminalToolExecutor.parseCommand(call.arguments)
        } catch (e: Exception) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Invalid command JSON arguments: ${e.message}",
            )
        }

        val raw = cmd.command.trim()
        if (raw.isEmpty()) {
            return SecurityDecision(SecurityDecisionKind.DENIED, "Command name must not be empty")
        }
        if (raw.contains('\u0000')) {
            return SecurityDecision(SecurityDecisionKind.DENIED, "Null byte detected in command string")
        }

        // Validate batch scripts on Windows
        val isWindows = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
        val lowerRaw = raw.lowercase(Locale.ROOT)
        if (isWindows && (lowerRaw.endsWith(".bat") || lowerRaw.endsWith(".cmd"))) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Execution of Windows batch scripts (.bat, .cmd) is disabled by security policy",
            )
        }

        // Validate working directory containment
        val wdCheck = validatePathBoundary(cmd.workingDirectory, workspaceRoot, mustExist = false)
        if (wdCheck != null) return wdCheck

        val cmdName = Path.of(raw.replace('\\', '/')).fileName?.toString() ?: raw
        val normalizedName = if (isWindows) {
            cmdName.lowercase(Locale.ROOT).removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
        } else {
            cmdName
        }

        // Unwrap wrapper commands (sudo, doas, env, busybox, nohup, pkexec, su, xargs)
        val unwrapped = unwrapCommand(cmdName, normalizedName, cmd.args)
        val effCmdName = unwrapped.effectiveCommand
        val effNormalized = unwrapped.effectiveNormalized
        val effArgs = unwrapped.effectiveArgs
        val isWrapped = unwrapped.isWrapped

        // 1. Strictly blocked commands (hard boundary in all presets)
        if (cmdName in TerminalConfig.DEFAULT_BLOCKED_COMMANDS ||
            normalizedName in TerminalConfig.DEFAULT_BLOCKED_COMMANDS ||
            effCmdName in TerminalConfig.DEFAULT_BLOCKED_COMMANDS ||
            effNormalized in TerminalConfig.DEFAULT_BLOCKED_COMMANDS
        ) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Command '$raw' is strictly forbidden by terminal security policy",
            )
        }

        // Ambiguous wrapper invocation (e.g. xargs with unrecognized flags or missing command)
        if (unwrapped.isAmbiguousWrapper) {
            if (!permissions.allowDeleteFile) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Ambiguous or unrecognized wrapper arguments cannot be verified safe when allowDeleteFile=false",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Ambiguous wrapper invocation '${cmd.command}' requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // Check if shell launcher arguments contain blocked commands or obfuscations
        val isShellLauncher = normalizedName in SHELL_LAUNCHERS || effNormalized in SHELL_LAUNCHERS
        val shellTokens = if (isShellLauncher) {
            val (shellBlockedDecision, tokens) = inspectShellLauncher(cmd)
            if (shellBlockedDecision != null) {
                return shellBlockedDecision
            }
            tokens
        } else {
            emptySet()
        }

        // Check command substitution in shell launchers when deletion is disabled
        if (isShellLauncher && !permissions.allowDeleteFile) {
            val hasSubstitution = cmd.args.any { it.contains("$(") || it.contains("`") }
            if (hasSubstitution) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Shell launcher with command substitution cannot be verified safe when allowDeleteFile is disabled",
                )
            }
        }

        // Parse Git arguments if git
        val isGit = normalizedName == "git" || effNormalized == "git"
        val rawGitInvocation = if (isGit) {
            parseGitArgs(if (effNormalized == "git") effArgs else cmd.args)
        } else {
            null
        }

        val parsedGit = if (isGit && rawGitInvocation != null) {
            val envHelperKeys = mutableListOf<String>()
            var envAliasDefinesDeletion = false

            val gitExtDiff = env["GIT_EXTERNAL_DIFF"]
            if (!gitExtDiff.isNullOrBlank()) envHelperKeys.add("GIT_EXTERNAL_DIFF")

            val gitSsh = env["GIT_SSH_COMMAND"] ?: env["GIT_SSH"]
            if (!gitSsh.isNullOrBlank()) envHelperKeys.add("GIT_SSH_COMMAND")

            val gitAskPass = env["GIT_ASKPASS"] ?: env["SSH_ASKPASS"]
            if (!gitAskPass.isNullOrBlank()) envHelperKeys.add("GIT_ASKPASS")

            val gitPager = env["GIT_PAGER"] ?: env["PAGER"]
            if (!gitPager.isNullOrBlank()) {
                val pagerVal = gitPager.trim().lowercase(Locale.ROOT)
                if (pagerVal != "cat" && pagerVal != "false") {
                    envHelperKeys.add(if (env.containsKey("GIT_PAGER")) "GIT_PAGER" else "PAGER")
                }
            }

            val gitConfigParams = env["GIT_CONFIG_PARAMETERS"]
            if (!gitConfigParams.isNullOrBlank()) {
                envHelperKeys.add("GIT_CONFIG_PARAMETERS")
                val paramsLower = gitConfigParams.lowercase(Locale.ROOT)
                if (paramsLower.contains("alias.") && (paramsLower.contains("!") || paramsLower.contains("clean") || paramsLower.contains("rm"))) {
                    envAliasDefinesDeletion = true
                }
            }

            val gitConfigCount = env["GIT_CONFIG_COUNT"]?.toIntOrNull() ?: 0
            for (c in 0 until gitConfigCount) {
                val k = env["GIT_CONFIG_KEY_$c"]
                val v = env["GIT_CONFIG_VALUE_$c"] ?: ""
                if (!k.isNullOrBlank()) {
                    if (isExternalHelperConfigKey(k)) {
                        envHelperKeys.add(k)
                    }
                    if (k.lowercase(Locale.ROOT).startsWith("alias.")) {
                        val valLower = v.lowercase(Locale.ROOT).trim()
                        val isShell = v.trim().startsWith("!")
                        val targetFirstWord = v.removePrefix("!").trim().split(Regex("\\s+")).firstOrNull()?.lowercase(Locale.ROOT) ?: ""
                        val isGitClean = targetFirstWord == "clean"
                        val isGitRm = targetFirstWord == "rm" && !valLower.contains("--cached")
                        val isDelWord = FILE_DELETION_COMMANDS.any { del -> valLower.contains("\\b$del\\b".toRegex()) || valLower.contains(del) }
                        val isBlockedWord = TerminalConfig.DEFAULT_BLOCKED_COMMANDS.any { b -> valLower.contains(b) }
                        if (isShell || isGitClean || isGitRm || isDelWord || isBlockedWord) {
                            envAliasDefinesDeletion = true
                        }
                    }
                }
            }

            val effectiveWorkingDir = try {
                val workDirStr = cmd.workingDirectory.trim()
                if (workDirStr.isEmpty() || workDirStr == ".") {
                    workspaceRoot
                } else {
                    workspaceRoot.resolve(workDirStr).normalize()
                }
            } catch (_: Exception) {
                workspaceRoot
            }

            val (repoConfig, repoUnres) = findAndParseGitConfig(effectiveWorkingDir, workspaceRoot)
            val (userConfig, userUnres) = parseUserGitConfig(userConfigPath, env)
            val (systemConfig, systemUnres) = parseSystemGitConfig(systemConfigPath, env)
            val allConfigs = systemConfig + userConfig + repoConfig
            val hasUnresolvedInclude = repoUnres || userUnres || systemUnres

            val configHelperKeys = mutableListOf<String>()
            var configAliasDefinesDeletion = false

            if (hasUnresolvedInclude) {
                configHelperKeys.add("unresolved_include")
            }

            for ((k, v) in allConfigs) {
                if (isExternalHelperConfigKey(k) && v.isNotBlank() && v.lowercase(Locale.ROOT) != "false" && v.lowercase(Locale.ROOT) != "cat") {
                    if (k !in configHelperKeys) configHelperKeys.add(k)
                }
                if (k.startsWith("alias.")) {
                    val valLower = v.lowercase(Locale.ROOT).trim()
                    val isShell = v.trim().startsWith("!")
                    val targetFirstWord = v.removePrefix("!").trim().split(Regex("\\s+")).firstOrNull()?.lowercase(Locale.ROOT) ?: ""
                    val isGitClean = targetFirstWord == "clean"
                    val isGitRm = targetFirstWord == "rm" && !valLower.contains("--cached")
                    val isDelWord = FILE_DELETION_COMMANDS.any { del -> valLower.contains("\\b$del\\b".toRegex()) || valLower.contains(del) }
                    val isBlockedWord = TerminalConfig.DEFAULT_BLOCKED_COMMANDS.any { b -> valLower.contains(b) }
                    if (isShell || isGitClean || isGitRm || isDelWord || isBlockedWord) {
                        configAliasDefinesDeletion = true
                    }
                }
            }

            val hasExternalHelper = rawGitInvocation.hasExternalHelperConfig || envHelperKeys.isNotEmpty() || configHelperKeys.isNotEmpty() || hasUnresolvedInclude
            val allExternalHelperKeys = (rawGitInvocation.externalHelperConfigKeys + envHelperKeys + configHelperKeys).distinct()
            val aliasDefinesDeletion = rawGitInvocation.aliasDefinesShellOrDeletion || configAliasDefinesDeletion || envAliasDefinesDeletion

            rawGitInvocation.copy(
                hasExternalHelperConfig = hasExternalHelper,
                externalHelperConfigKeys = allExternalHelperKeys,
                aliasDefinesShellOrDeletion = aliasDefinesDeletion,
            )
        } else {
            null
        }

        // Ambiguous or malformed Git global options
        if (parsedGit != null && parsedGit.isAmbiguousGlobalOptions) {
            if (!permissions.allowDeleteFile) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Ambiguous or incomplete Git global options cannot be verified safe when allowDeleteFile=false",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Ambiguous Git invocation requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // 2. Check file deletion via terminal (hard boundary when allowDeleteFile=false)
        val isDeletionCommand = isTerminalDeletionCommand(normalizedName, cmd, shellTokens, parsedGit) ||
            (isWrapped && isTerminalDeletionCommand(effNormalized, TerminalCommand(effCmdName, effArgs, cmd.workingDirectory), shellTokens, parsedGit))

        if (isDeletionCommand && !permissions.allowDeleteFile) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Deleting files via terminal is disabled in security permissions (allowDeleteFile=false)",
            )
        }

        // 3. Check destructive Git operations
        val isDestructiveGit = if (isGit && parsedGit != null) {
            isDestructiveGitCommand("git", cmd, parsedGit)
        } else {
            false
        }

        // Categorize Git commands
        val isMutatingGit = isGit && parsedGit != null && parsedGit.category == GitCategory.MUTATING
        val isUnknownGit = isGit && parsedGit != null && parsedGit.category == GitCategory.UNKNOWN

        // 4. Check dangerous commands
        val isDangerous = isDangerousCommand(
            cmdName = cmdName,
            normalizedName = normalizedName,
            cmd = cmd,
            isDestructiveGit = isDestructiveGit,
            isDeletion = isDeletionCommand,
            isWrapped = isWrapped,
            parsedGit = parsedGit,
        )

        val isAllowlisted = (cmdName in TerminalConfig.DEFAULT_ALLOWED_COMMANDS ||
            normalizedName in TerminalConfig.DEFAULT_ALLOWED_COMMANDS) && !isWrapped

        // In Turbo mode:
        if (preset == SecurityPreset.TURBO) {
            if (!permissions.allowArbitraryCommands && !isAllowlisted) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
                )
            }
            if (isDestructiveGit) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Destructive Git operation '${cmd.command}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isDeletionCommand) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Terminal file deletion command '${cmd.command}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isShellLauncher) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Shell launcher '${cmd.command}' requires user confirmation in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isMutatingGit) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Mutating Git operation '${cmd.command} ${parsedGit.subcommand}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isUnknownGit) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Unknown Git subcommand or alias '${parsedGit.subcommand}' requires user confirmation in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (parsedGit != null && parsedGit.definesAlias) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Git invocation defining or modifying aliases requires user confirmation in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (parsedGit != null && parsedGit.hasExternalHelperConfig) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Git command specifies or inherits external helper/program configuration (${parsedGit.externalHelperConfigKeys.joinToString(", ")}) requiring user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isDangerous) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Dangerous command '${cmd.command}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            return SecurityDecision(kind = SecurityDecisionKind.ALLOWED_IMMEDIATE)
        }

        // In Request Review mode: every permitted command requires confirmation
        if (preset == SecurityPreset.REQUEST_REVIEW) {
            if (!permissions.allowArbitraryCommands && !isAllowlisted) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Request Review mode: confirmation required for command '${cmd.command}'",
                approvalCommand = cmd,
            )
        }

        // In Auto mode:
        // Command execution does not automatically execute; requires confirmation
        if (preset == SecurityPreset.AUTO) {
            if (!permissions.allowArbitraryCommands && !isAllowlisted) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Auto mode: terminal command '${cmd.command}' requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // In Default mode:
        // Shell launchers ALWAYS require confirmation in Default mode regardless of requireApprovalForDangerous
        if (isShellLauncher) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Shell launcher '${cmd.command}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        // Mutating Git operations, unknown subcommands, and alias definitions ALWAYS require confirmation
        if (isMutatingGit) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Mutating Git operation '${cmd.command} ${parsedGit.subcommand}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (isUnknownGit) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Unknown Git subcommand or alias '${parsedGit.subcommand}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (parsedGit != null && parsedGit.definesAlias) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Git invocation defining or modifying aliases requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (parsedGit != null && parsedGit.hasExternalHelperConfig) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Git command specifies or inherits external helper/program configuration (${parsedGit.externalHelperConfigKeys.joinToString(", ")}) requiring user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (isDangerous && permissions.requireApprovalForDangerous) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Command '${cmd.command}' is marked as dangerous and requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // Safe command: check allowlist
        if (!permissions.allowArbitraryCommands && !isAllowlisted) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
            )
        }

        return SecurityDecision(kind = SecurityDecisionKind.ALLOWED_IMMEDIATE)
    }

    private fun inspectShellLauncher(cmd: TerminalCommand): Pair<SecurityDecision?, Set<String>> {
        val extractedTokens = mutableSetOf<String>()
        val textSnippets = mutableListOf<String>()

        var i = 0
        while (i < cmd.args.size) {
            val arg = cmd.args[i]

            // Check for PowerShell encoded command flags (-e, -enc, -Encoded, -EncodedCommand, etc.)
            val encMatch = Regex("^-(?:e|enc|enco|encod|encode|encoded|encodedcommand)(?:[:=](.+))?$", RegexOption.IGNORE_CASE).find(arg)
            if (encMatch != null) {
                val inlinePayload = encMatch.groupValues[1]
                val base64Payload = if (inlinePayload.isNotEmpty()) {
                    inlinePayload
                } else if (i + 1 < cmd.args.size) {
                    i++
                    cmd.args[i]
                } else {
                    null
                }

                if (base64Payload != null) {
                    val decodedText = try {
                        val bytes = java.util.Base64.getDecoder().decode(base64Payload.trim())
                        // PowerShell uses UTF-16LE for encoded commands
                        val utf16 = String(bytes, java.nio.charset.StandardCharsets.UTF_16LE).trim()
                        if (utf16.any { it != '\u0000' && it.isDefined() }) {
                            utf16
                        } else {
                            String(bytes, java.nio.charset.StandardCharsets.UTF_8).trim()
                        }
                    } catch (_: Exception) {
                        return Pair(
                            SecurityDecision(
                                kind = SecurityDecisionKind.DENIED,
                                reason = "Undecodable or invalid encoded shell command argument",
                            ),
                            emptySet(),
                        )
                    }
                    textSnippets.add(decodedText)
                }
            } else {
                textSnippets.add(arg)
            }
            i++
        }

        // Collect tokens from raw args and decoded snippets
        for (snippet in textSnippets) {
            val lowerSnippet = snippet.lowercase(Locale.ROOT)
            for (blocked in TerminalConfig.DEFAULT_BLOCKED_COMMANDS) {
                if (lowerSnippet.contains("\\b$blocked\\b".toRegex()) || lowerSnippet.contains(blocked)) {
                    return Pair(
                        SecurityDecision(
                            kind = SecurityDecisionKind.DENIED,
                            reason = "Shell launcher argument contains strictly forbidden command: $blocked",
                        ),
                        emptySet(),
                    )
                }
            }

            // Check unquoted and unescaped version to defeat obfuscation (e.g. f"o"r"m"a"t, f\ormat, r\m)
            val unescaped = snippet.replace("\\", "").replace("\"", "").replace("'", "")
            val unescapedLower = unescaped.lowercase(Locale.ROOT)
            for (blocked in TerminalConfig.DEFAULT_BLOCKED_COMMANDS) {
                if (unescapedLower.contains("\\b$blocked\\b".toRegex()) || unescapedLower.contains(blocked)) {
                    return Pair(
                        SecurityDecision(
                            kind = SecurityDecisionKind.DENIED,
                            reason = "Shell launcher argument contains obfuscated forbidden command: $blocked",
                        ),
                        emptySet(),
                    )
                }
            }

            // Split into individual tokens for deletion / subcommand inspection
            val tokens = unescaped.split(Regex("[\\s;&|`$<>(){}]+"))
            for (t in tokens) {
                val clean = t.trim().lowercase(Locale.ROOT)
                if (clean.isNotEmpty()) {
                    extractedTokens.add(clean)
                }
            }
        }

        return Pair(null, extractedTokens)
    }

    private fun parseGitArgs(args: List<String>): GitParsedInvocation {
        val optionsWithSeparateArg = setOf(
            "-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env"
        )
        val configs = mutableListOf<String>()
        var subcmd: String? = null
        var subArgs = emptyList<String>()
        var definesAlias = false
        var aliasDefinesShellOrDeletion = false
        var hasOpaqueConfigEnvAlias = false
        var hasExternalHelperConfig = false
        val externalHelperConfigKeys = mutableListOf<String>()
        var isAmbiguousGlobalOptions = false
        var hasVersionFlag = false
        var i = 0

        while (i < args.size) {
            val arg = args[i]

            // Check --config-env option
            if (arg == "--config-env") {
                if (i + 1 < args.size) {
                    val cfg = args[i + 1]
                    configs.add(cfg)
                    val cfgKey = cfg.substringBefore("=").lowercase(Locale.ROOT).trim()
                    if (cfgKey.startsWith("alias.") || cfgKey.contains("alias.")) {
                        definesAlias = true
                        hasOpaqueConfigEnvAlias = true
                        aliasDefinesShellOrDeletion = true
                    }
                    if (isExternalHelperConfigKey(cfgKey)) {
                        hasExternalHelperConfig = true
                        if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                    }
                    i += 2
                    continue
                } else {
                    isAmbiguousGlobalOptions = true
                    break
                }
            } else if (arg.startsWith("--config-env=")) {
                val cfg = arg.substringAfter("=")
                configs.add(cfg)
                val cfgKey = cfg.substringBefore("=").lowercase(Locale.ROOT).trim()
                if (cfgKey.startsWith("alias.") || cfgKey.contains("alias.")) {
                    definesAlias = true
                    hasOpaqueConfigEnvAlias = true
                    aliasDefinesShellOrDeletion = true
                }
                if (isExternalHelperConfigKey(cfgKey)) {
                    hasExternalHelperConfig = true
                    if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                }
                i++
                continue
            }

            // Check -c config option
            if (arg == "-c") {
                if (i + 1 < args.size) {
                    val cfg = args[i + 1]
                    configs.add(cfg)
                    val cfgKey = cfg.substringBefore("=").lowercase(Locale.ROOT).trim()
                    if (isExternalHelperConfigKey(cfgKey)) {
                        hasExternalHelperConfig = true
                        if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                    }
                    i += 2
                    continue
                } else {
                    isAmbiguousGlobalOptions = true
                    break
                }
            } else if (arg.startsWith("-c") && arg.length > 2 && !arg.startsWith("--")) {
                val cfg = arg.substring(2)
                configs.add(cfg)
                val cfgKey = cfg.substringBefore("=").lowercase(Locale.ROOT).trim()
                if (isExternalHelperConfigKey(cfgKey)) {
                    hasExternalHelperConfig = true
                    if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                }
                i++
                continue
            }

            // Check version flags
            if (arg == "-v" || arg == "--version") {
                hasVersionFlag = true
            }

            // Options taking a separate argument
            if (arg in optionsWithSeparateArg) {
                if (i + 1 < args.size) {
                    i += 2
                    continue
                } else {
                    isAmbiguousGlobalOptions = true
                    break
                }
            }

            // Options with inline argument =
            if (arg.startsWith("--") && arg.contains("=")) {
                i++
                continue
            }

            // Standalone flags like --no-pager or --exec-path or -p
            if (arg.startsWith("-")) {
                i++
                continue
            }

            // First non-option token is the subcommand
            subcmd = arg.lowercase(Locale.ROOT)
            subArgs = if (i + 1 < args.size) args.subList(i + 1, args.size) else emptyList()
            break
        }

        // Analyze configs for alias definitions, external helpers, and dangerous commands
        for (cfg in configs) {
            val cfgKey = cfg.substringBefore("=").lowercase(Locale.ROOT).trim()
            val valPart = cfg.substringAfter("=", "").trim()
            val valLower = valPart.lowercase(Locale.ROOT)

            if (isExternalHelperConfigKey(cfgKey)) {
                hasExternalHelperConfig = true
                if (cfgKey !in externalHelperConfigKeys) {
                    externalHelperConfigKeys.add(cfgKey)
                }
            }

            if (cfgKey.startsWith("alias.") || cfgKey.startsWith("alias")) {
                definesAlias = true
                val targetFirstWord = valLower.removePrefix("!").trim().split(Regex("\\s+")).firstOrNull() ?: ""
                val isShell = valPart.startsWith("!")
                val isGitClean = targetFirstWord == "clean"
                val isGitRm = targetFirstWord == "rm" && !valLower.contains("--cached")
                val isDelWord = FILE_DELETION_COMMANDS.any { del ->
                    valLower.contains("\\b$del\\b".toRegex()) || valLower.contains(del)
                }
                val isBlockedWord = TerminalConfig.DEFAULT_BLOCKED_COMMANDS.any { b -> valLower.contains(b) }
                if (isShell || isGitClean || isGitRm || isDelWord || isBlockedWord) {
                    aliasDefinesShellOrDeletion = true
                }
            }
        }

        // Also check if subcommand is "config" and modifies an alias or external helper
        if (subcmd == "config") {
            val fullConfigArgs = subArgs.joinToString(" ").lowercase(Locale.ROOT)
            if (fullConfigArgs.contains("alias.") || fullConfigArgs.contains("alias ")) {
                definesAlias = true
                val targetTokens = subArgs.drop(1).joinToString(" ").lowercase(Locale.ROOT)
                val targetFirstWord = targetTokens.removePrefix("!").trim().split(Regex("\\s+")).firstOrNull() ?: ""
                val isShell = targetTokens.contains("!")
                val isGitClean = targetFirstWord == "clean" || targetTokens.contains("clean ") || targetTokens.endsWith("clean")
                val isGitRm = (targetFirstWord == "rm" || targetTokens.contains("rm ")) && !targetTokens.contains("--cached")
                val isDelWord = FILE_DELETION_COMMANDS.any { del -> fullConfigArgs.contains("\\b$del\\b".toRegex()) }
                val isBlockedWord = TerminalConfig.DEFAULT_BLOCKED_COMMANDS.any { b -> fullConfigArgs.contains(b) }
                if (isShell || isGitClean || isGitRm || isDelWord || isBlockedWord) {
                    aliasDefinesShellOrDeletion = true
                }
            }
            if (subArgs.any { isExternalHelperConfigKey(it.substringBefore("=")) }) {
                hasExternalHelperConfig = true
                for (a in subArgs) {
                    val k = a.substringBefore("=").lowercase(Locale.ROOT).trim()
                    if (isExternalHelperConfigKey(k) && k !in externalHelperConfigKeys) {
                        externalHelperConfigKeys.add(k)
                    }
                }
            }
        }

        val category = classifyGitSubcommand(subcmd, subArgs, hasVersionFlag, hasExternalHelperConfig)

        return GitParsedInvocation(
            subcommand = subcmd,
            subcommandArgs = subArgs,
            configs = configs,
            definesAlias = definesAlias,
            aliasDefinesShellOrDeletion = aliasDefinesShellOrDeletion,
            hasOpaqueConfigEnvAlias = hasOpaqueConfigEnvAlias,
            hasExternalHelperConfig = hasExternalHelperConfig,
            externalHelperConfigKeys = externalHelperConfigKeys,
            category = category,
            isAmbiguousGlobalOptions = isAmbiguousGlobalOptions,
        )
    }

    private fun classifyGitSubcommand(
        subcmd: String?,
        subArgs: List<String>,
        hasVersionFlag: Boolean = false,
        hasExternalHelperConfig: Boolean = false,
    ): GitCategory {
        if (hasExternalHelperConfig) {
            return GitCategory.MUTATING
        }
        if (subcmd == null) {
            return if (hasVersionFlag) GitCategory.READ_ONLY else GitCategory.UNKNOWN
        }

        if (subcmd in BASE_READ_ONLY_GIT_SUBCOMMANDS) {
            if (subcmd == "diff" || subcmd == "show" || subcmd == "log") {
                val hasExternalOrOutputFlag = subArgs.any { arg ->
                    arg == "--ext-diff" ||
                    arg.startsWith("--ext-diff=") ||
                    arg == "--textconv" ||
                    arg.startsWith("--textconv=") ||
                    arg == "--output" ||
                    arg.startsWith("--output=") ||
                    arg == "-o" ||
                    (arg.startsWith("-o") && arg.length > 2 && !arg.startsWith("--"))
                }
                if (hasExternalOrOutputFlag) {
                    return GitCategory.MUTATING
                }
            }
            return GitCategory.READ_ONLY
        }

        if (subcmd == "branch") {
            val mutatingBranchFlags = setOf(
                "-d", "-D", "--delete", "-m", "-M", "--move", "-c", "-C", "--copy",
                "--edit-description", "--set-upstream-to", "-u", "--unset-upstream"
            )
            if (subArgs.any { it in mutatingBranchFlags || mutatingBranchFlags.any { f -> it.startsWith("$f=") } }) {
                return GitCategory.MUTATING
            }

            val listFlagsWithArg = setOf(
                "--contains", "--no-contains", "--merged", "--no-merged", "--sort", "--format", "--points-at"
            )
            val listStandaloneFlags = setOf(
                "-a", "--all", "-r", "--remotes", "-v", "-vv", "--verbose", "-l", "--list",
                "--show-current", "-i", "--ignore-case", "-q", "--quiet", "--no-color", "--color",
                "--column", "--no-column"
            )
            val hasListFlag = subArgs.any { it == "-l" || it == "--list" }

            var i = 0
            while (i < subArgs.size) {
                val a = subArgs[i]
                if (a in listStandaloneFlags) {
                    i++
                    continue
                }
                if (a in listFlagsWithArg) {
                    i += 2
                    continue
                }
                if (listFlagsWithArg.any { f -> a.startsWith("$f=") }) {
                    i++
                    continue
                }
