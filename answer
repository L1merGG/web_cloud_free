        assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, policy.evaluate(roCall, SecurityPermissions(), SecurityPreset.REQUEST_REVIEW, workspaceDir).kind)
        assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, policy.evaluate(mutCall, SecurityPermissions(), SecurityPreset.REQUEST_REVIEW, workspaceDir).kind)

        // 2. AUTO: all terminal commands require approval
        assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, policy.evaluate(roCall, SecurityPermissions(), SecurityPreset.AUTO, workspaceDir).kind)
        assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, policy.evaluate(mutCall, SecurityPermissions(), SecurityPreset.AUTO, workspaceDir).kind)

        // 3. DEFAULT: read-only is ALLOWED_IMMEDIATE, mutating is REQUIRES_APPROVAL
        assertEquals(SecurityDecisionKind.ALLOWED_IMMEDIATE, policy.evaluate(roCall, SecurityPermissions(), SecurityPreset.DEFAULT, workspaceDir).kind)
        assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, policy.evaluate(mutCall, SecurityPermissions(), SecurityPreset.DEFAULT, workspaceDir).kind)

        // 4. TURBO: read-only is ALLOWED_IMMEDIATE, mutating is REQUIRES_APPROVAL
        assertEquals(SecurityDecisionKind.ALLOWED_IMMEDIATE, policy.evaluate(roCall, SecurityPermissions(), SecurityPreset.TURBO, workspaceDir).kind)
        assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, policy.evaluate(mutCall, SecurityPermissions(), SecurityPreset.TURBO, workspaceDir).kind)

        // Hard deny: disabled allowExecuteCommand blocks both in all presets
        val noExecPerms = SecurityPermissions(allowExecuteCommand = false)
        for (preset in SecurityPreset.entries) {
            assertEquals(SecurityDecisionKind.DENIED, policy.evaluate(roCall, noExecPerms, preset, workspaceDir).kind)
            assertEquals(SecurityDecisionKind.DENIED, policy.evaluate(mutCall, noExecPerms, preset, workspaceDir).kind)
        }
    }
