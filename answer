                } catch (_: Exception) {
                    return Pair(emptyMap(), true)
                }
            }
            if (curr == workspaceRoot || curr.parent == null) break
            curr = curr.parent
        }
        return Pair(emptyMap(), false)
    }

    internal fun parseUserGitConfig(
        userConfigPath: Path?,
        env: Map<String, String>,
        currentGitDir: Path? = null,
    ): Pair<Map<String, String>, Boolean> {
        val envGlobal = env["GIT_CONFIG_GLOBAL"] ?: System.getenv("GIT_CONFIG_GLOBAL") ?: System.getProperty("GIT_CONFIG_GLOBAL")
        if (!envGlobal.isNullOrBlank()) {
            return parseGitConfigFile(Path.of(envGlobal), currentGitDir = currentGitDir)
        }
        if (userConfigPath != null) {
            return parseGitConfigFile(userConfigPath, currentGitDir = currentGitDir)
        }
        val merged = mutableMapOf<String, String>()
        var hasUnres = false
        val home = System.getProperty("user.home")
        if (!home.isNullOrBlank()) {
            val homeConfig = Path.of(home, ".gitconfig")
            if (Files.isRegularFile(homeConfig)) {
                val (entries, unres) = parseGitConfigFile(homeConfig, currentGitDir = currentGitDir)
                merged.putAll(entries)
                if (unres) hasUnres = true
            }
        }
        val xdgConfigHome = env["XDG_CONFIG_HOME"] ?: System.getenv("XDG_CONFIG_HOME") ?: System.getProperty("XDG_CONFIG_HOME")
        val xdgPath = if (!xdgConfigHome.isNullOrBlank()) {
            Path.of(xdgConfigHome, "git", "config")
        } else if (!home.isNullOrBlank()) {
            Path.of(home, ".config", "git", "config")
        } else null

        if (xdgPath != null && Files.isRegularFile(xdgPath)) {
            val (entries, unres) = parseGitConfigFile(xdgPath, currentGitDir = currentGitDir)
            merged.putAll(entries)
            if (unres) hasUnres = true
        }
        return Pair(merged, hasUnres)
    }

    internal fun parseSystemGitConfig(
        systemConfigPath: Path?,
        env: Map<String, String>,
        currentGitDir: Path? = null,
    ): Pair<Map<String, String>, Boolean> {
        val noSystem = env["GIT_CONFIG_NOSYSTEM"] ?: System.getenv("GIT_CONFIG_NOSYSTEM") ?: System.getProperty("GIT_CONFIG_NOSYSTEM")
        val noSysLower = noSystem?.trim()?.lowercase(Locale.ROOT)
        if (noSysLower == "1" || noSysLower == "true" || noSysLower == "yes") {
            return Pair(emptyMap(), false)
        }
        val envSystem = env["GIT_CONFIG_SYSTEM"] ?: System.getenv("GIT_CONFIG_SYSTEM") ?: System.getProperty("GIT_CONFIG_SYSTEM")
        if (!envSystem.isNullOrBlank()) {
            return parseGitConfigFile(Path.of(envSystem), currentGitDir = currentGitDir)
        }
        if (systemConfigPath != null) {
            return parseGitConfigFile(systemConfigPath, currentGitDir = currentGitDir)
        }
        val merged = mutableMapOf<String, String>()
        var hasUnres = false
        val candidates = mutableListOf<Path>()
        val progData = env["ProgramData"] ?: System.getenv("ProgramData")
        if (!progData.isNullOrBlank()) {
            candidates.add(Path.of(progData, "Git", "config"))
        }
        candidates.add(Path.of("C:\\ProgramData\\Git\\config"))
        candidates.add(Path.of("C:\\Program Files\\Git\\etc\\gitconfig"))
        candidates.add(Path.of("/etc/gitconfig"))

        for (cand in candidates) {
            if (Files.isRegularFile(cand)) {
                val (entries, unres) = parseGitConfigFile(cand, currentGitDir = currentGitDir)
                merged.putAll(entries)
                if (unres) hasUnres = true
                break
            }
        }
        return Pair(merged, hasUnres)
    }

    internal fun parseGitConfigEnv(env: Map<String, String>): Map<String, String> {
        val result = mutableMapOf<String, String>()
        val count = env["GIT_CONFIG_COUNT"]?.toIntOrNull() ?: 0
        for (i in 0 until count) {
            val k = env["GIT_CONFIG_KEY_$i"]?.trim()?.lowercase(Locale.ROOT)
            val v = env["GIT_CONFIG_VALUE_$i"] ?: ""
            if (!k.isNullOrBlank()) {
                result[k] = v
            }
        }
        val params = env["GIT_CONFIG_PARAMETERS"]
        if (!params.isNullOrBlank()) {
            val tokens = splitConfigParameters(params)
            for (token in tokens) {
                if (token.contains("=")) {
                    val k = token.substringBefore("=").trim().lowercase(Locale.ROOT)
                    val v = token.substringAfter("=").trim()
                    if (k.isNotEmpty()) {
                        result[k] = v
                    }
                }
            }
        }
        return result
    }

    private fun splitConfigParameters(params: String): List<String> {
        val result = mutableListOf<String>()
        val current = StringBuilder()
        var inSingle = false
        var inDouble = false
        for (ch in params) {
            when {
                ch == '\'' && !inDouble -> inSingle = !inSingle
                ch == '"' && !inSingle -> inDouble = !inDouble
                ch.isWhitespace() && !inSingle && !inDouble -> {
                    if (current.isNotEmpty()) {
                        result.add(current.toString().removeSurrounding("'").removeSurrounding("\""))
                        current.clear()
                    }
                }
                else -> current.append(ch)
            }
        }
        if (current.isNotEmpty()) {
            result.add(current.toString().removeSurrounding("'").removeSurrounding("\""))
        }
        return result
    }

    internal data class EffectiveGitConfig(
        val entries: Map<String, String>,
        val hasUnresolved: Boolean = false,
        val isReliable: Boolean = true,
    )

    internal fun readEffectiveGitConfig(
        effectiveWorkingDir: Path,
        workspaceRoot: Path,
        env: Map<String, String>,
        userConfigPath: Path? = null,
        systemConfigPath: Path? = null,
    ): EffectiveGitConfig {
        val (repoConfig, repoUnres) = findAndParseGitConfig(effectiveWorkingDir, workspaceRoot)
        val (userConfig, userUnres) = parseUserGitConfig(userConfigPath, env, effectiveWorkingDir)
        val (systemConfig, systemUnres) = parseSystemGitConfig(systemConfigPath, env, effectiveWorkingDir)
        val envConfig = parseGitConfigEnv(env)

        val nativeEntries = mutableMapOf<String, String>()
        try {
            val pb = ProcessBuilder("git", "--no-pager", "config", "--includes", "--null", "--list")
            val targetDir = if (Files.isDirectory(effectiveWorkingDir)) effectiveWorkingDir else workspaceRoot
            pb.directory(targetDir.toFile())
            val procEnv = pb.environment()
            for ((k, v) in env) {
                procEnv[k] = v
            }
            val home = System.getProperty("user.home")
            if (!home.isNullOrBlank() && !procEnv.containsKey("USERPROFILE") && !env.containsKey("USERPROFILE")) {
                procEnv["USERPROFILE"] = home
                procEnv["HOME"] = home
            }
            val xdgProp = env["XDG_CONFIG_HOME"] ?: System.getenv("XDG_CONFIG_HOME") ?: System.getProperty("XDG_CONFIG_HOME")
            if (!xdgProp.isNullOrBlank() && !procEnv.containsKey("XDG_CONFIG_HOME")) {
                procEnv["XDG_CONFIG_HOME"] = xdgProp
            }
            if (userConfigPath != null) {
                procEnv["GIT_CONFIG_GLOBAL"] = userConfigPath.toAbsolutePath().toString()
            }
            if (systemConfigPath != null) {
                procEnv["GIT_CONFIG_SYSTEM"] = systemConfigPath.toAbsolutePath().toString()
            }
            val noSys = env["GIT_CONFIG_NOSYSTEM"]?.trim()?.lowercase(Locale.ROOT)
            if (noSys == "1" || noSys == "true" || noSys == "yes") {
                procEnv["GIT_CONFIG_NOSYSTEM"] = "1"
            }
            pb.redirectErrorStream(true)

            val proc = pb.start()
            val outputStream = ByteArrayOutputStream()
            val buf = ByteArray(4096)
            val startTime = System.currentTimeMillis()
            var totalBytes = 0
            var exceededLimit = false

            val input = proc.inputStream
            while (true) {
                if (input.available() > 0) {
                    val r = input.read(buf)
                    if (r < 0) break
                    totalBytes += r
                    if (totalBytes > 262144) {
                        exceededLimit = true
                        proc.destroyForcibly()
                        break
                    }
                    outputStream.write(buf, 0, r)
                } else {
                    if (proc.waitFor(50, TimeUnit.MILLISECONDS)) {
                        while (true) {
                            val r = input.read(buf)
                            if (r <= 0) break
                            totalBytes += r
                            if (totalBytes > 262144) {
                                exceededLimit = true
                                break
                            }
                            outputStream.write(buf, 0, r)
                        }
                        break
                    }
                    if (System.currentTimeMillis() - startTime > 2000) {
                        proc.destroyForcibly()
                        break
                    }
                }
            }

            if (!exceededLimit && !proc.isAlive && proc.exitValue() == 0) {
                val rawBytes = outputStream.toByteArray()
                var start = 0
                for (i in 0 until rawBytes.size) {
                    if (rawBytes[i] == 0.toByte()) {
                        if (i > start) {
                            val chunk = String(rawBytes, start, i - start, Charsets.UTF_8)
                            val nlIdx = chunk.indexOf('\n')
                            if (nlIdx >= 0) {
                                val key = chunk.substring(0, nlIdx).trim().lowercase(Locale.ROOT)
                                val value = chunk.substring(nlIdx + 1)
                                nativeEntries[key] = value
                            }
                        }
                        start = i + 1
                    }
                }
            }
        } catch (_: Exception) {
            // fallback
        }

        val merged = mutableMapOf<String, String>()
        // 1. Base from native git (respects includes, active includeIf, machine defaults)
        merged.putAll(nativeEntries)
        // 2. Overlay explicit system config (if not NOSYSTEM)
        val noSystem = env["GIT_CONFIG_NOSYSTEM"]?.trim()?.lowercase(Locale.ROOT)
        if (noSystem != "1" && noSystem != "true" && noSystem != "yes") {
            merged.putAll(systemConfig)
        }
        // 3. Overlay user config
        merged.putAll(userConfig)
        // 4. Overlay repo config (e.g. from local .git/config, worktree)
        merged.putAll(repoConfig)
        // 5. Overlay env config (highest precedence)
        merged.putAll(envConfig)

        val hasUnres = repoUnres || userUnres || systemUnres
        return EffectiveGitConfig(entries = merged, hasUnresolved = hasUnres, isReliable = !hasUnres)
    }

    internal fun doesHelperAffectSubcommand(
        helperKey: String,
        helperValue: String,
        subcommand: String?,
        subcommandArgs: List<String>,
        rawArgs: List<String>,
        env: Map<String, String>,
    ): Boolean {
        if (helperKey == "unresolved_include" || helperKey == "unresolved_config") {
            return true
        }

        val k = helperKey.lowercase(Locale.ROOT).trim()
        val v = helperValue.trim()
        val sub = subcommand?.lowercase(Locale.ROOT)?.trim() ?: ""

        val vLower = v.lowercase(Locale.ROOT)
        if (vLower == "false" || vLower == "cat" || vLower == "none" || vLower == "/bin/cat") {
            return false
        }
        if (vLower == "astextplain" || k == "diff.astextplain.textconv") {
            return false
        }
        if (k.startsWith("filter.lfs.")) {
            return false
        }

        val hasNoPager = rawArgs.any { it == "--no-pager" || it == "-P" }

        if (k == "core.pager" || k == "git_pager" || k == "pager") {
            if (hasNoPager) return false
            val pagerSubcommands = setOf("log", "diff", "show", "branch", "shortlog")
            return sub in pagerSubcommands
        }
        if (k.startsWith("pager.")) {
            if (hasNoPager) return false
            val targetCmd = k.removePrefix("pager.").trim()
            return sub == targetCmd
        }

        if (k == "diff.external" || k == "git_external_diff" ||
            (k.startsWith("diff.") && (k.endsWith(".command") || k.endsWith(".textconv"))) ||
            k == "diff.tool" || k.startsWith("difftool.")
        ) {
            if (sub == "diff" || sub == "show" || sub == "difftool") return true
            if (sub == "log" && (subcommandArgs.any { it == "-p" || it == "-u" || it == "--patch" || it == "--stat" })) return true
            return false
        }

        if (k == "core.fsmonitor" || k.startsWith("core.fsmonitor.")) {
            return sub == "status" || sub == "diff" || sub in MUTATING_GIT_SUBCOMMANDS
        }

        if (k == "credential.helper" || k.startsWith("credential.") ||
            k == "core.sshcommand" || k == "git_ssh_command" ||
            (k.startsWith("remote.") && (k.endsWith(".receivepack") || k.endsWith(".uploadpack") || k.endsWith(".vcs")))
        ) {
            val networkSubcommands = setOf("push", "fetch", "pull", "clone", "ls-remote", "submodule")
            if (sub in networkSubcommands) return true
            if (sub == "remote") {
                val firstArg = subcommandArgs.firstOrNull { !it.startsWith("-") }
                val hasN = subcommandArgs.any { it == "-n" || it == "--no-query" }
                if (firstArg == "show" && !hasN) return true
                if (firstArg == "update" || firstArg == "prune") return true
                if (k == "git_ssh_command" || k == "core.sshcommand" || k.endsWith(".uploadpack") || k.endsWith(".receivepack")) return true
                return false
            }
            return false
        }

        if (k.startsWith("filter.")) {
            val filterSubcommands = setOf("checkout", "switch", "restore", "add", "commit", "reset", "diff", "status")
            return sub in filterSubcommands
        }

        if (k == "core.editor" || k == "sequence.editor" || k == "core.askpass" || k == "git_editor" || k == "editor" || k == "visual") {
            if (sub == "tag") {
                val isReadOnlyTag = subcommandArgs.isEmpty() || subcommandArgs.any { it == "-l" || it == "--list" }
                if (isReadOnlyTag) return false
            }
            val editorSubcommands = setOf("commit", "rebase", "tag", "merge")
            return sub in editorSubcommands
        }

        if (k.startsWith("browser.")) {
            val browserSubcommands = setOf("web--browse", "help", "instaweb")
            return sub in browserSubcommands
        }

        return true
    }

    fun evaluate(
        call: ToolCall,
        permissions: SecurityPermissions,
        preset: SecurityPreset,
        workspaceRoot: Path,
        env: Map<String, String> = System.getenv(),
        userConfigPath: Path? = null,
        systemConfigPath: Path? = null,
    ): SecurityDecision {
        return when (call.name) {
            "read_file" -> evaluateReadFile(call, permissions, preset, workspaceRoot)
            "list_directory" -> evaluateListDirectory(call, permissions, preset, workspaceRoot)
            "write_file" -> evaluateWriteFile(call, permissions, preset, workspaceRoot)
            "create_directory" -> evaluateCreateDirectory(call, permissions, preset, workspaceRoot)
            "delete_file" -> evaluateDeleteFile(call, permissions, preset, workspaceRoot)
            "execute_command" -> evaluateExecuteCommand(call, permissions, preset, workspaceRoot, env, userConfigPath, systemConfigPath)
            else -> SecurityDecision(
                kind = SecurityDecisionKind.UNKNOWN_TOOL,
                reason = "Unknown tool '${call.name}' is not recognized or supported by security policy",
            )
        }
    }

    private fun evaluateReadFile(
        call: ToolCall,
        permissions: SecurityPermissions,
        preset: SecurityPreset,
        workspaceRoot: Path,
    ): SecurityDecision {
        if (!permissions.allowReadFile) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Reading files is disabled in security permissions",
            )
        }

        val pathStr = extractPathArg(call)
            ?: return SecurityDecision(SecurityDecisionKind.DENIED, "Missing required argument 'path'")

        val pathCheck = validatePathBoundary(pathStr, workspaceRoot, mustExist = false)
        if (pathCheck != null) return pathCheck

        val approvalCmd = TerminalCommand(
            command = "read_file",
            args = listOf(pathStr),
            workingDirectory = ".",
        )

        return when (preset) {
            SecurityPreset.REQUEST_REVIEW -> SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Request Review mode: confirmation required for reading file '$pathStr'",
                approvalCommand = approvalCmd,
            )
            SecurityPreset.DEFAULT,
            SecurityPreset.AUTO,
            SecurityPreset.TURBO -> SecurityDecision(
                kind = SecurityDecisionKind.ALLOWED_IMMEDIATE,
            )
        }
    }

    private fun evaluateListDirectory(
        call: ToolCall,
        permissions: SecurityPermissions,
        preset: SecurityPreset,
        workspaceRoot: Path,
    ): SecurityDecision {
        if (!permissions.allowReadFile) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Reading/listing directory contents is disabled in security permissions",
            )
        }

        val pathStr = extractPathArg(call) ?: "."
        val pathCheck = validatePathBoundary(pathStr, workspaceRoot, mustExist = false)
        if (pathCheck != null) return pathCheck

        val approvalCmd = TerminalCommand(
            command = "list_directory",
