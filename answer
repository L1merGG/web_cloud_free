    internal fun evaluateGitIncludeIfCondition(
        condition: String,
        currentGitDir: Path?,
        baseDir: Path?,
    ): Boolean {
        if (currentGitDir == null) return false
        val condTrim = condition.trim()
        val isWin = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
        val isCaseInsensitive = condTrim.startsWith("gitdir/i:", ignoreCase = true) || isWin
        val rawPattern = when {
            condTrim.startsWith("gitdir/i:", ignoreCase = true) -> condTrim.substring("gitdir/i:".length).trim()
            condTrim.startsWith("gitdir:", ignoreCase = true) -> condTrim.substring("gitdir:".length).trim()
            else -> return false
        }

        var pattern = rawPattern.removeSurrounding("\"").removeSurrounding("'").trim().replace('\\', '/')
        if (pattern.startsWith("~/")) {
            val home = (System.getProperty("user.home") ?: "").replace('\\', '/')
            pattern = "$home/${pattern.removePrefix("~/")}"
        } else if (pattern.startsWith("./") && baseDir != null) {
            val baseNorm = baseDir.toAbsolutePath().normalize().toString().replace('\\', '/')
            pattern = "$baseNorm/${pattern.removePrefix("./")}"
        }

        if (pattern.endsWith("/")) {
            pattern = "$pattern**"
        }
        if (!pattern.startsWith("/") && !pattern.startsWith("**/") && !pattern.contains(":/")) {
            pattern = "**/$pattern"
        }

        val workTreeDir = currentGitDir.toAbsolutePath().normalize().toString().replace('\\', '/')
        val dotGitDir = if (workTreeDir.endsWith("/.git")) workTreeDir else "$workTreeDir/.git"

        return matchesGitGlob(pattern, workTreeDir, isCaseInsensitive) ||
               matchesGitGlob(pattern, dotGitDir, isCaseInsensitive)
    }

    private fun matchesGitGlob(pattern: String, pathStr: String, ignoreCase: Boolean): Boolean {
        val normPattern = pattern.trim().replace('\\', '/')
        val normPath = pathStr.trim().replace('\\', '/')
        if (normPattern.endsWith("/**")) {
            val prefix = normPattern.removeSuffix("/**")
            if (normPath.equals(prefix, ignoreCase = ignoreCase) ||
                normPath.startsWith("$prefix/", ignoreCase = ignoreCase) ||
                normPath.startsWith(prefix, ignoreCase = ignoreCase)) {
                return true
            }
        }
        val regexSb = StringBuilder("^")
        var i = 0
        while (i < normPattern.length) {
            if (normPattern.startsWith("/**/", i)) {
                regexSb.append("(/.*)?/")
                i += 4
            } else if (normPattern.startsWith("/**", i) && i + 3 == normPattern.length) {
                regexSb.append("(/.*)?")
                i += 3
            } else if (normPattern.startsWith("**/", i)) {
                regexSb.append("(.*/)?")
                i += 3
            } else if (normPattern.startsWith("**", i)) {
                regexSb.append(".*")
                i += 2
            } else if (normPattern[i] == '*') {
                regexSb.append("[^/]*")
                i++
            } else if (normPattern[i] == '?') {
                regexSb.append("[^/]")
                i++
            } else {
                val ch = normPattern[i]
                if ("\\.^$|()[]{}+".contains(ch)) {
                    regexSb.append('\\')
                }
                regexSb.append(ch)
                i++
            }
        }
        regexSb.append("$")
        val regex = if (ignoreCase) Regex(regexSb.toString(), RegexOption.IGNORE_CASE) else Regex(regexSb.toString())
        return regex.matches(normPath) || regex.matches("$normPath/")
    }

    internal fun parseGitConfigContent(
        content: String,
        baseDir: Path? = null,
        visited: MutableSet<Path> = mutableSetOf(),
        depth: Int = 0,
        currentGitDir: Path? = null,
    ): Pair<Map<String, String>, Boolean> {
        val result = mutableMapOf<String, String>()
        var currentSection = ""
        var hasUnresolvedInclude = false
        var hasSyntaxError = false

        for (rawLine in content.lines()) {
            val line = rawLine.trim()
            if (line.isEmpty() || line.startsWith("#") || line.startsWith(";")) continue
            if (line.startsWith("[") && line.endsWith("]")) {
                val sectionContent = line.substring(1, line.length - 1).trim()
                if (sectionContent.isEmpty()) {
                    hasSyntaxError = true
                    continue
                }
                if (sectionContent.contains('"')) {
                    val secName = sectionContent.substringBefore('"').trim().lowercase(Locale.ROOT)
                    val subSec = sectionContent.substringAfter('"').substringBeforeLast('"').trim()
                    currentSection = "$secName.$subSec"
                } else {
                    currentSection = sectionContent.lowercase(Locale.ROOT)
                }
                continue
            }
            if (line.contains("=")) {
                val key = line.substringBefore("=").trim().lowercase(Locale.ROOT)
                val value = line.substringAfter("=").trim()
                if (key.isEmpty() || currentSection.isEmpty()) {
                    hasSyntaxError = true
                }
                val fullKey = if (currentSection.isNotEmpty()) "$currentSection.$key" else key
                result[fullKey] = value

                val isInclude = fullKey == "include.path"
                val isIncludeIf = fullKey.startsWith("includeif.") && fullKey.endsWith(".path")

                if (isInclude || isIncludeIf) {
                    var shouldInclude = isInclude
                    if (isIncludeIf) {
                        val condition = fullKey.removePrefix("includeif.").removeSuffix(".path").trim()
                        shouldInclude = evaluateGitIncludeIfCondition(condition, currentGitDir, baseDir)
                    }

                    if (shouldInclude) {
                        val incPathStr = value.removeSurrounding("\"").removeSurrounding("'").trim()
                        if (incPathStr.isNotEmpty() && depth < 10) {
                            try {
                                val targetPath = when {
                                    incPathStr.startsWith("~/") -> {
                                        val home = System.getProperty("user.home") ?: ""
                                        if (home.isNotBlank()) Path.of(home, incPathStr.removePrefix("~/")) else null
                                    }
                                    Path.of(incPathStr).isAbsolute -> Path.of(incPathStr)
                                    baseDir != null -> baseDir.resolve(incPathStr).normalize()
                                    else -> null
                                }

                                if (targetPath != null && Files.isRegularFile(targetPath)) {
                                    val norm = targetPath.toAbsolutePath().normalize()
                                    if (norm !in visited) {
                                        visited.add(norm)
                                        val subContent = Files.readString(norm)
                                        val (subEntries, subUnres) = parseGitConfigContent(
                                            subContent,
                                            norm.parent,
                                            visited,
                                            depth + 1,
                                            currentGitDir,
                                        )
                                        result.putAll(subEntries)
                                        if (subUnres) hasUnresolvedInclude = true
                                    } else {
                                        // Cyclic include
                                        hasUnresolvedInclude = true
                                    }
                                } else {
                                    hasUnresolvedInclude = true
                                }
                            } catch (_: Exception) {
                                hasUnresolvedInclude = true
                            }
                        } else if (incPathStr.isNotEmpty()) {
                            hasUnresolvedInclude = true
                        }
                    }
                }
            } else {
                hasSyntaxError = true
            }
        }
        return Pair(result, hasUnresolvedInclude || hasSyntaxError)
    }

    internal fun parseGitConfigFile(
        file: Path,
        visited: MutableSet<Path> = mutableSetOf(),
        depth: Int = 0,
        currentGitDir: Path? = null,
    ): Pair<Map<String, String>, Boolean> {
        if (!Files.isRegularFile(file)) return Pair(emptyMap(), false)
        val norm = file.toAbsolutePath().normalize()
        if (norm in visited) return Pair(emptyMap(), true)
        visited.add(norm)
        return try {
            val content = Files.readString(norm)
            parseGitConfigContent(content, norm.parent, visited, depth, currentGitDir)
        } catch (_: Exception) {
            Pair(emptyMap(), true)
        }
    }

    internal fun findAndParseGitConfig(startDir: Path, workspaceRoot: Path): Pair<Map<String, String>, Boolean> {
        var curr: Path? = startDir
        val merged = mutableMapOf<String, String>()
        var hasUnres = false

        while (curr != null) {
            val dotGit = curr.resolve(".git")
            if (Files.isDirectory(dotGit)) {
                val configFile = dotGit.resolve("config")
                if (Files.isRegularFile(configFile)) {
                    val (entries, unres) = parseGitConfigFile(configFile, currentGitDir = curr)
                    merged.putAll(entries)
                    if (unres) hasUnres = true
                }
                val worktreeConfigFile = dotGit.resolve("config.worktree")
                if (Files.isRegularFile(worktreeConfigFile)) {
                    val (entries, unres) = parseGitConfigFile(worktreeConfigFile, currentGitDir = curr)
                    merged.putAll(entries)
                    if (unres) hasUnres = true
                }
                return Pair(merged, hasUnres)
            } else if (Files.isRegularFile(dotGit)) {
                try {
                    val line = Files.readAllLines(dotGit).firstOrNull()?.trim() ?: ""
                    if (line.startsWith("gitdir:")) {
