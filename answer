class CountingMockToolExecutor : ToolExecutor {
    var callCount: Int = 0
    val executedCalls = mutableListOf<ToolCall>()

    override suspend fun execute(call: ToolCall): ToolResult {
        callCount++
        executedCalls.add(call)
        return ToolResult(
            toolCallId = call.id,
            content = "Executed: ${call.name}",
            success = true,
        )
    }
}

class PolicyEnforcingToolExecutorTest {

    @Test
    fun testProductionPathStandardGitConfigDiscoveryBlocksDirectExecution() = runBlocking {
        val originalHome = System.getProperty("user.home")
        val tempHome = Files.createTempDirectory("antigooglity-user-home")
        val workspaceDir = Files.createTempDirectory("antigooglity-workspace")

        try {
            System.setProperty("user.home", tempHome.toAbsolutePath().toString())

            // Write ~/.gitconfig with dangerous helper (core.pager)
            val globalGitConfig = tempHome.resolve(".gitconfig")
            Files.writeString(globalGitConfig, """
                [core]
                    pager = /usr/bin/test-pager
            """.trimIndent())

            val mockDelegate = CountingMockToolExecutor()
            val perms = SecurityPermissions(allowExecuteCommand = true, allowArbitraryCommands = true)

            // Production pipeline: PolicyEnforcingToolExecutor without explicit userConfigPath
            val enforcingExecutor = PolicyEnforcingToolExecutor(
                delegate = mockDelegate,
                workspacePath = { workspaceDir },
                permissions = { perms },
                preset = { SecurityPreset.TURBO },
                commandApprover = null, // No approver configured -> fails immediately on REQUIRES_APPROVAL
            )

            val logCall = ToolCall(
                id = "call_git_log",
                name = "execute_command",
                arguments = """{"command":"git","args":["log"]}""",
            )

            val result = enforcingExecutor.execute(logCall)

            // 1. Result should indicate security violation needing approval
            assertFalse(result.success)
            assertTrue(result.content.contains("Security violation"))
            assertTrue(result.content.contains("requires user approval"))

            // 2. Delegate MUST NOT be called!
            assertEquals(0, mockDelegate.callCount)

            // 3. Harmless command without helper bypass (e.g. git log with --no-pager)
            val noPagerCall = ToolCall(
                id = "call_git_log_nopager",
                name = "execute_command",
                arguments = """{"command":"git","args":["--no-pager","log"]}""",
            )
            val noPagerResult = enforcingExecutor.execute(noPagerCall)
            assertTrue(noPagerResult.success)
            assertEquals(1, mockDelegate.callCount)
        } finally {
            if (originalHome != null) {
                System.setProperty("user.home", originalHome)
            }
            tempHome.toFile().deleteRecursively()
            workspaceDir.toFile().deleteRecursively()
        }
    }

