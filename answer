                workspaceDir,
                systemConfigPath = sysConfig,
                env = mapOf("GIT_CONFIG_NOSYSTEM" to "1"),
            )
            // When system config is skipped and no other helper is configured, log is ALLOWED_IMMEDIATE
            assertEquals(SecurityDecisionKind.ALLOWED_IMMEDIATE, noSysDec.kind)

