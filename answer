                        if (Files.isRegularFile(worktreeConfig)) {
                            val (entries, unres) = parseGitConfigFile(worktreeConfig, currentGitDir = curr)
                            merged.putAll(entries)
                            if (unres) hasUnres = true
                        }
                        val commonDirFile = gitDirPath.resolve("commondir")
                        if (Files.isRegularFile(commonDirFile)) {
                            val commonDirStr = Files.readString(commonDirFile).trim()
                            val commonDirPath = gitDirPath.resolve(commonDirStr).normalize()
                            val commonConfig = commonDirPath.resolve("config")
                            if (Files.isRegularFile(commonConfig)) {
                                val (entries, unres) = parseGitConfigFile(commonConfig, currentGitDir = curr)
