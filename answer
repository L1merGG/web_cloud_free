using System;
using System.Drawing;
using System.Windows.Forms;

namespace Antigooglity.WebView2Host
{
    internal sealed class BrowserHostForm : Form
    {
        public bool IsExiting { get; set; }
        public bool IsVisibleBrowserMode { get; set; }

        public BrowserHostForm()
        {
            Text = "Antigooglity - Google Gemini Session";
            ShowInTaskbar = false;
            WindowState = FormWindowState.Normal;
            FormBorderStyle = FormBorderStyle.Sizable;
            StartPosition = FormStartPosition.CenterScreen;
            Size = new Size(1100, 800);
            MinimumSize = new Size(600, 400);

            // Hide off-screen by default until configured
            Location = new Point(-32000, -32000);
        }

        public void ConfigureVisibleBrowserMode()
        {
            IsVisibleBrowserMode = true;
            ShowInTaskbar = true;
            FormBorderStyle = FormBorderStyle.Sizable;
            StartPosition = FormStartPosition.CenterScreen;
            CenterToScreen();
            Visible = true;
            BringToFront();
            Activate();
        }

        protected override void SetVisibleCore(bool value)
        {
            if (IsVisibleBrowserMode)
            {
                base.SetVisibleCore(value);
                return;
            }

            // In background host mode:
            // Prevent the window from ever becoming visible.
            // When Form.Show() is called, base.SetVisibleCore creates the HWND.
            // By passing false, the window handle is created, but the window
            // remains completely invisible (no taskbar icon, no screen flicker).
            base.SetVisibleCore(false);
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            if (IsVisibleBrowserMode)
            {
                // In visible browser mode, user closing the window exits the application cleanly
                IsExiting = true;
                base.OnFormClosing(e);
                return;
            }

            if (!IsExiting && e.CloseReason == CloseReason.UserClosing)
            {
                // Prevent accidental close from user in background host mode;
                // only shutdown on IPC exit command or process termination
                e.Cancel = true;
                return;
            }
            base.OnFormClosing(e);
        }
    }
}
