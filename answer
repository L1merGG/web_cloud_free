            val wipeCall = ToolCall(id = "g_wipe_env_cnt", name = "execute_command", arguments = "{\"command\":\"git\",\"args\":[\"wipe\"]}")
            val noDelPerms = SecurityPermissions(allowDeleteFile = false, allowExecuteCommand = true, allowArbitraryCommands = true)
