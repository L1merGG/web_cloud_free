            java.nio.file.Files.createDirectories(dotGit)
            val mainConfig = dotGit.resolve("config")
            val fileA = dotGit.resolve("fileA.config")
            val fileB = dotGit.resolve("fileB.config")

            // File B contains the dangerous helper
            java.nio.file.Files.writeString(fileB, """
                [diff]
                    external = /usr/bin/incif-diff
                [core]
                    fsmonitor = /usr/bin/incif-fsmonitor
            """.trimIndent())

            // File A includes File B (nested include)
            val fileBPosix = fileB.toAbsolutePath().toString().replace('\\', '/')
            java.nio.file.Files.writeString(fileA, """
                [include]
                    path = $fileBPosix
            """.trimIndent())

            // Main config has includeIf with Windows backslashes and wildcard /**
            val repoBackslashes = repoDir.toAbsolutePath().toString().replace('/', '\\')
            val fileAPosix = fileA.toAbsolutePath().toString().replace('\\', '/')
            java.nio.file.Files.writeString(mainConfig, """
                [core]
                    repositoryformatversion = 0
                [includeIf "gitdir:${repoBackslashes}/**"]
                    path = $fileAPosix
            """.trimIndent())

            val perms = SecurityPermissions(allowExecuteCommand = true, allowArbitraryCommands = true)
            val diffCall = ToolCall(id = "g_diff_incif", name = "execute_command", arguments = """{"command":"git","args":["diff"]}""")
            val statusCall = ToolCall(id = "g_status_incif", name = "execute_command", arguments = """{"command":"git","args":["status"]}""")

            // When conditionally included helper is active -> REQUIRES_APPROVAL
            val turboDiff = policy.evaluate(diffCall, perms, SecurityPreset.TURBO, repoDir)
            assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, turboDiff.kind)
            assertTrue(turboDiff.approvalCommand != null)
            assertTrue(turboDiff.reason.contains("diff.external") || turboDiff.reason.contains("core.fsmonitor"))

            val turboStatus = policy.evaluate(statusCall, perms, SecurityPreset.TURBO, repoDir)
            assertEquals(SecurityDecisionKind.REQUIRES_APPROVAL, turboStatus.kind)
            assertTrue(turboStatus.approvalCommand != null)
        } finally {
            repoDir.toFile().deleteRecursively()
        }
    }

