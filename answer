using Microsoft.Web.WebView2.Core;

namespace Antigooglity.WebView2Host
{
    public sealed class BrowserController : IDisposable
    {
        private CoreWebView2Environment? _environment;
        private CoreWebView2Controller? _controller;
        private CoreWebView2? _webView;
        private readonly string _userDataFolder;
        private readonly string _initialUrl;
        private readonly Action<string, object?> _logCallback;
        private bool _isInitialized;
        private bool _isDisposed;

        public bool IsInitialized => _isInitialized && _webView != null;
        public CoreWebView2? CoreWebView => _webView;
        public CoreWebView2Controller? Controller => _controller;

        public event EventHandler<string>? NavigationCompleted;
        public event EventHandler<string>? NavigationStarting;

        public BrowserController(
            string? userDataFolder = null,
            string? initialUrl = null,
            Action<string, object?>? logCallback = null)
        {
            _userDataFolder = userDataFolder ?? Path.Combine(
                Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
                "Antigooglity", "webview2-profile");
            _initialUrl = initialUrl ?? "https://gemini.google.com";
            _logCallback = logCallback ?? ((msg, data) => { });
        }

        public async Task InitializeAsync(IntPtr hwnd, bool isVisibleBrowser = false)
        {
            if (_isInitialized) return;

            Directory.CreateDirectory(_userDataFolder);

            _logCallback("Initializing WebView2 environment...", new { userDataFolder = _userDataFolder });

            var envOptions = new CoreWebView2EnvironmentOptions();

            _environment = await CoreWebView2Environment.CreateAsync(
                browserExecutableFolder: null,
                userDataFolder: _userDataFolder,
                options: envOptions);

            _logCallback("Creating CoreWebView2Controller...", new { hwnd = hwnd.ToString("X") });

            _controller = await _environment.CreateCoreWebView2ControllerAsync(hwnd);

            // Configure controller visibility
            _controller.IsVisible = isVisibleBrowser;

            _webView = _controller.CoreWebView2;

            // Configure settings
            _webView.Settings.IsScriptEnabled = true;
            _webView.Settings.AreDefaultScriptDialogsEnabled = true;
            _webView.Settings.IsWebMessageEnabled = true;
            _webView.Settings.AreDevToolsEnabled = isVisibleBrowser;
            _webView.Settings.AreDefaultContextMenusEnabled = isVisibleBrowser;
            _webView.Settings.IsStatusBarEnabled = isVisibleBrowser;

            // Wire navigation events
            _webView.NavigationStarting += (s, e) =>
            {
                _logCallback("Navigation starting", new { uri = e.Uri });
                NavigationStarting?.Invoke(this, e.Uri);
            };

            _webView.NavigationCompleted += (s, e) =>
            {
                _logCallback("Navigation completed", new { isSuccess = e.IsSuccess, status = e.WebErrorStatus });
                NavigationCompleted?.Invoke(this, _webView.Source);
            };

            // Navigate to initial URL
            _logCallback("Navigating to initial URL...", new { url = _initialUrl });
            _webView.Navigate(_initialUrl);

            _isInitialized = true;
            _logCallback("WebView2 initialization completed.", null);
        }

        public void Navigate(string url)
        {
            EnsureInitialized();
            _logCallback("Navigating to URL", new { url });
            _webView!.Navigate(url);
        }

        public void Resize(int width, int height)
        {
            if (_controller != null && !_isDisposed)
            {
                _controller.Bounds = new System.Drawing.Rectangle(0, 0, width, height);
            }
        }

        public async Task<string> ExecuteScriptAsync(string script, int timeoutMs = 10000)
        {
            EnsureInitialized();

            using var cts = new CancellationTokenSource(timeoutMs);
            var tcs = new TaskCompletionSource<string>();

            using (cts.Token.Register(() => tcs.TrySetCanceled()))
            {
                try
                {
                    var execTask = _webView!.ExecuteScriptAsync(script);
                    var completedTask = await Task.WhenAny(execTask, tcs.Task);

                    if (completedTask == tcs.Task)
                    {
                        throw new TimeoutException($"Script execution timed out after {timeoutMs}ms");
                    }

                    return await execTask;
                }
                catch (OperationCanceledException)
                {
                    throw new TimeoutException($"Script execution timed out after {timeoutMs}ms");
                }
            }
        }

        public async Task<string> EvaluateScriptUnwrappedAsync(string script, int timeoutMs = 10000)
        {
            var rawResult = await ExecuteScriptAsync(script, timeoutMs);
            if (rawResult == null || rawResult == "null") return "";

            if (rawResult.StartsWith("\"") && rawResult.EndsWith("\""))
            {
                try
                {
                    return JsonSerializer.Deserialize<string>(rawResult) ?? "";
                }
                catch
                {
                    return rawResult.Substring(1, rawResult.Length - 2);
                }
            }

            return rawResult;
        }

