            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Writing files is disabled in security permissions",
            )
        }

        // Determine if target file already exists
        val pathStr = ToolArgsParser.extractPath(call.arguments)
        val fileExists = if (pathStr != null) {
            try {
                val candidate = workspaceRoot.resolve(pathStr).normalize()
                candidate.toFile().exists()
            } catch (e: Exception) {
                false
            }
        } else {
            false
        }

        return when (preset) {
            SecurityPreset.REQUEST_REVIEW -> SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Request Review mode: all actions require user confirmation",
            )
            SecurityPreset.DEFAULT -> SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = if (fileExists) {
                    "Overwriting existing file requires user confirmation in Default mode"
                } else {
                    "Writing file requires user confirmation in Default mode"
                },
            )
            SecurityPreset.AUTO -> {
                if (fileExists) {
                    SecurityDecision(
                        kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                        reason = "Auto mode: overwriting existing file requires confirmation to prevent data loss",
                    )
                } else {
                    SecurityDecision(
                        kind = SecurityDecisionKind.ALLOWED_IMMEDIATE,
                    )
                }
            }
            SecurityPreset.TURBO -> SecurityDecision(
                kind = SecurityDecisionKind.ALLOWED_IMMEDIATE,
            )
        }
    }

    private fun evaluateDeleteFile(
        call: ToolCall,
        permissions: SecurityPermissions,
        preset: SecurityPreset,
        workspaceRoot: Path,
    ): SecurityDecision {
        if (!permissions.allowDeleteFile) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Deleting files is disabled in security permissions",
            )
        }

        val pathStr = ToolArgsParser.extractPath(call.arguments) ?: "target"
        val approvalCmd = TerminalCommand(
            command = "delete_file",
            args = listOf(pathStr),
            workingDirectory = ".",
        )

        return when (preset) {
            SecurityPreset.REQUEST_REVIEW,
            SecurityPreset.DEFAULT,
            SecurityPreset.AUTO -> SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Deleting files is a sensitive operation requiring user confirmation",
                approvalCommand = approvalCmd,
            )
            SecurityPreset.TURBO -> SecurityDecision(
                kind = SecurityDecisionKind.ALLOWED_IMMEDIATE,
            )
        }
    }

    private fun evaluateExecuteCommand(
        call: ToolCall,
        permissions: SecurityPermissions,
        preset: SecurityPreset,
        workspaceRoot: Path,
    ): SecurityDecision {
        if (!permissions.allowExecuteCommand) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Executing terminal commands is disabled in security permissions",
            )
        }

        val cmd = try {
            TerminalToolExecutor.parseCommand(call.arguments)
        } catch (e: Exception) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Invalid command JSON arguments: ${e.message}",
            )
        }

        val raw = cmd.command.trim()
        if (raw.isEmpty()) {
            return SecurityDecision(SecurityDecisionKind.DENIED, "Command name must not be empty")
        }
        if (raw.contains('\u0000')) {
            return SecurityDecision(SecurityDecisionKind.DENIED, "Null byte detected in command string")
        }

        // Validate batch scripts on Windows
        val isWindows = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
        val lowerRaw = raw.lowercase(Locale.ROOT)
        if (isWindows && (lowerRaw.endsWith(".bat") || lowerRaw.endsWith(".cmd"))) {
            if (raw.contains('&') || raw.contains('|') || raw.contains('<') ||
                raw.contains('>') || raw.contains('^') || raw.contains('%')) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Batch script contains characters prone to Windows cmd.exe injection",
                )
            }
        }

        val cmdName = Path.of(raw.replace('\\', '/')).fileName?.toString() ?: raw
        val normalizedName = if (isWindows) {
            cmdName.lowercase(Locale.ROOT).removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
        } else {
            cmdName.lowercase(Locale.ROOT)
        }

        // Unwrap wrappers (sudo, env, nohup, xargs, etc.)
        val unwrapResult = unwrapCommand(raw, normalizedName, cmd.args)
        val isWrapped = unwrapResult.isWrapped
        val effCmdName = unwrapResult.effectiveCommand
        val effNormalized = unwrapResult.effectiveNormalized
        val effArgs = unwrapResult.effectiveArgs

        // Ambiguous wrapper invocations cannot be safely resolved
        if (unwrapResult.isAmbiguousWrapper) {
            if (!permissions.allowDeleteFile) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Ambiguous or incomplete wrapper command cannot be verified safe when allowDeleteFile=false",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Ambiguous wrapper command '${cmd.command}' requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // 1. Blocked commands check (hard boundary)
        val isBlocked = cmdName in TerminalConfig.DEFAULT_BLOCKED_COMMANDS ||
            normalizedName in TerminalConfig.DEFAULT_BLOCKED_COMMANDS ||
            (isWrapped && (effCmdName in TerminalConfig.DEFAULT_BLOCKED_COMMANDS || effNormalized in TerminalConfig.DEFAULT_BLOCKED_COMMANDS))

        if (isBlocked) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Command '${if (isWrapped) effCmdName else raw}' is in the blocked commands list",
            )
        }

        // Inspect shell launchers for dangerous operations and nested commands
        val isShellLauncher = normalizedName in SHELL_LAUNCHERS || (isWrapped && effNormalized in SHELL_LAUNCHERS)
        val shellTokens = if (isShellLauncher) {
            extractShellCommandTokens(if (isWrapped) effArgs else cmd.args)
        } else {
            emptySet()
        }

        if (isShellLauncher) {
            for (blocked in TerminalConfig.DEFAULT_BLOCKED_COMMANDS) {
                if (blocked in shellTokens) {
                    return SecurityDecision(
                        kind = SecurityDecisionKind.DENIED,
                        reason = "Shell launcher attempts to execute blocked command '$blocked'",
                    )
                }
            }
        }

        // Shell launcher with command substitution when allowDeleteFile=false
        if (isShellLauncher && !permissions.allowDeleteFile) {
            val shellArgsJoined = (if (isWrapped) effArgs else cmd.args).joinToString(" ")
            if (shellArgsJoined.contains("$(") || shellArgsJoined.contains("`")) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Shell launcher with command substitution cannot be verified safe when allowDeleteFile is disabled",
                )
            }
        }

        // Parse Git arguments if git
        val isGit = normalizedName == "git" || effNormalized == "git"
        val parsedGit = if (isGit) {
            parseGitArgs(if (effNormalized == "git") effArgs else cmd.args)
        } else {
            null
        }

        // Ambiguous or malformed Git global options
        if (parsedGit != null && parsedGit.isAmbiguousGlobalOptions) {
            if (!permissions.allowDeleteFile) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Ambiguous or incomplete Git global options cannot be verified safe when allowDeleteFile=false",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Ambiguous Git invocation requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // 2. Check file deletion via terminal (hard boundary when allowDeleteFile=false)
        val isDeletionCommand = isTerminalDeletionCommand(normalizedName, cmd, shellTokens, parsedGit) ||
            (isWrapped && isTerminalDeletionCommand(effNormalized, TerminalCommand(effCmdName, effArgs, cmd.workingDirectory), shellTokens, parsedGit))

        if (isDeletionCommand && !permissions.allowDeleteFile) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Deleting files via terminal is disabled in security permissions (allowDeleteFile=false)",
            )
        }

        // 3. Check destructive Git operations
        val isDestructiveGit = if (isGit && parsedGit != null) {
            isDestructiveGitCommand("git", cmd, parsedGit)
        } else {
            false
        }

        // Categorize Git commands
        val isMutatingGit = isGit && parsedGit != null && parsedGit.category == GitCategory.MUTATING
        val isUnknownGit = isGit && parsedGit != null && parsedGit.category == GitCategory.UNKNOWN

        // 4. Check dangerous commands
        val isDangerous = isDangerousCommand(
            cmdName = cmdName,
            normalizedName = normalizedName,
            cmd = cmd,
            isDestructiveGit = isDestructiveGit,
            isDeletion = isDeletionCommand,
            isWrapped = isWrapped,
            parsedGit = parsedGit,
        )

        val isAllowlisted = (cmdName in TerminalConfig.DEFAULT_ALLOWED_COMMANDS ||
            normalizedName in TerminalConfig.DEFAULT_ALLOWED_COMMANDS) && !isWrapped

        // In Turbo mode:
        if (preset == SecurityPreset.TURBO) {
            if (!permissions.allowArbitraryCommands && !isAllowlisted) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
                )
            }
            if (isDestructiveGit) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Destructive Git operation '${cmd.command}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isDeletionCommand) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Terminal file deletion command '${cmd.command}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isShellLauncher) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Shell launcher '${cmd.command}' requires user confirmation in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isMutatingGit) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Mutating Git operation '${cmd.command} ${parsedGit.subcommand}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isUnknownGit) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Unknown Git subcommand or alias '${parsedGit.subcommand}' requires user confirmation in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (parsedGit != null && parsedGit.definesAlias) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Git invocation defining or modifying aliases requires user confirmation in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (parsedGit != null && parsedGit.hasExternalHelperConfig) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Git command specifies external helper/program configuration (${parsedGit.externalHelperConfigKeys.joinToString(", ")}) requiring user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            if (isDangerous) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                    reason = "Dangerous command '${cmd.command}' requires user confirmation even in Turbo mode",
                    approvalCommand = cmd,
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.ALLOWED_IMMEDIATE,
            )
        }

        // In Request Review mode:
        if (preset == SecurityPreset.REQUEST_REVIEW) {
            if (!permissions.allowArbitraryCommands && !isAllowlisted) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Request Review mode: all terminal commands require user confirmation",
                approvalCommand = cmd,
            )
        }

        // In Auto mode:
        // Command execution does not automatically execute; requires confirmation
        if (preset == SecurityPreset.AUTO) {
            if (!permissions.allowArbitraryCommands && !isAllowlisted) {
                return SecurityDecision(
                    kind = SecurityDecisionKind.DENIED,
                    reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
                )
            }
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Auto mode: terminal command '${cmd.command}' requires user confirmation",
                approvalCommand = cmd,
            )
        }

        // In Default mode:
        // Shell launchers ALWAYS require confirmation in Default mode regardless of requireApprovalForDangerous
        if (isShellLauncher) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Shell launcher '${cmd.command}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        // Mutating Git operations, unknown subcommands, and alias definitions ALWAYS require confirmation
        if (isMutatingGit) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Mutating Git operation '${cmd.command} ${parsedGit.subcommand}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (isUnknownGit) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Unknown Git subcommand or alias '${parsedGit.subcommand}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (parsedGit != null && parsedGit.definesAlias) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Git invocation defining or modifying aliases requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        if (parsedGit != null && parsedGit.hasExternalHelperConfig) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Git command specifies external helper/program configuration (${parsedGit.externalHelperConfigKeys.joinToString(", ")}) requiring user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        // If allowArbitraryCommands is disabled and command is not allowlisted -> DENIED
        if (!permissions.allowArbitraryCommands && !isAllowlisted) {
            return SecurityDecision(
                kind = SecurityDecisionKind.DENIED,
                reason = "Command '$raw' is not in the allowed commands list and allowArbitraryCommands is disabled",
            )
        }

        // In Default mode, dangerous commands require approval
        if (permissions.requireApprovalForDangerous && isDangerous) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Dangerous command '${cmd.command}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        // If arbitrary commands are allowed and command is not allowlisted -> REQUIRES_APPROVAL in Default mode
        if (permissions.allowArbitraryCommands && !isAllowlisted) {
            return SecurityDecision(
                kind = SecurityDecisionKind.REQUIRES_APPROVAL,
                reason = "Non-allowlisted command '${cmd.command}' requires user confirmation in Default mode",
                approvalCommand = cmd,
            )
        }

        return SecurityDecision(
            kind = SecurityDecisionKind.ALLOWED_IMMEDIATE,
        )
    }

    private fun isDangerousCommand(
        cmdName: String,
        normalizedName: String,
        cmd: TerminalCommand,
        isDestructiveGit: Boolean,
        isDeletion: Boolean,
        isWrapped: Boolean,
        parsedGit: GitParsedInvocation? = null,
    ): Boolean {
        if (isDestructiveGit) return true
        if (isDeletion) return true

        if (normalizedName in TerminalConfig.DEFAULT_DANGEROUS_COMMANDS ||
            cmdName in TerminalConfig.DEFAULT_DANGEROUS_COMMANDS) {
            return true
        }

        // Chained command symbols in arguments
        val joinedArgs = cmd.args.joinToString(" ")
        if (joinedArgs.contains("&&") || joinedArgs.contains("||") ||
            joinedArgs.contains(";") || joinedArgs.contains("|")) {
            return true
        }

        return false
    }

    private fun extractShellCommandTokens(args: List<String>): Set<String> {
        val tokens = mutableSetOf<String>()
        val separators = Regex("[;\\|&\\n\\r`]")

        var i = 0
        while (i < args.size) {
            val a = args[i]
            if (a == "-c" || a == "/c" || a == "-Command" || a == "-command" || a == "/C") {
                if (i + 1 < args.size) {
                    val fullScript = args[i + 1]
                    val parts = fullScript.split(separators)
                    for (part in parts) {
                        val word = part.trim().split(Regex("\\s+")).firstOrNull() ?: ""
                        if (word.isNotEmpty()) {
                            val cleanWord = Path.of(word.replace('\\', '/')).fileName?.toString() ?: word
                            val norm = cleanWord.lowercase(Locale.ROOT)
                                .removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
                            tokens.add(norm)
                        }
                    }
                }
            }
            i++
        }
        return tokens
    }

    internal fun parseGitArgs(args: List<String>): GitParsedInvocation {
        val globalOptsWithArg = setOf(
            "-C", "-c", "--exec-path", "--html-path", "--man-path", "--info-path",
            "-work-tree", "--work-tree", "--namespace", "--super-prefix", "--config-env",
        )
        val standaloneGlobalOpts = setOf(
            "--version", "--help", "-p", "--paginate", "-P", "--no-pager",
            "--no-replace-objects", "--bare", "--literal-pathspecs",
            "--glob-pathspecs", "--noglob-pathspecs", "--icase-pathspecs",
            "--no-optional-locks",
        )

        var subcmd: String? = null
        var subArgs = emptyList<String>()
        var definesAlias = false
        var aliasDefinesShellOrDeletion = false
        var hasOpaqueConfigEnvAlias = false
        var hasExternalHelperConfig = false
        val externalHelperConfigKeys = mutableListOf<String>()
        var isAmbiguousGlobalOptions = false
        var hasVersionFlag = false
        val configs = mutableListOf<String>()

        var i = 0
        while (i < args.size) {
            val a = args[i]

            // Check --config-env=key=ENV_NAME or --config-env key=ENV_NAME
            if (a.startsWith("--config-env=")) {
                val cfgPart = a.substringAfter("--config-env=")
                val cfgKey = cfgPart.substringBefore("=").trim()
                if (cfgKey.lowercase(Locale.ROOT).startsWith("alias.")) {
                    definesAlias = true
                    hasOpaqueConfigEnvAlias = true
                    aliasDefinesShellOrDeletion = true
                }
                if (isExternalHelperConfigKey(cfgKey)) {
                    hasExternalHelperConfig = true
                    if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                }
                i++
                continue
            }
            if (a == "--config-env") {
                if (i + 1 < args.size) {
                    val cfgPart = args[i + 1]
                    val cfgKey = cfgPart.substringBefore("=").trim()
                    if (cfgKey.lowercase(Locale.ROOT).startsWith("alias.")) {
                        definesAlias = true
                        hasOpaqueConfigEnvAlias = true
                        aliasDefinesShellOrDeletion = true
                    }
                    if (isExternalHelperConfigKey(cfgKey)) {
                        hasExternalHelperConfig = true
                        if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                    }
                    i += 2
                    continue
                } else {
                    isAmbiguousGlobalOptions = true
                    break
                }
            }

            // Check -c key=val or -ckey=val
            if (a.startsWith("-c")) {
                if (a == "-c") {
                    if (i + 1 < args.size) {
                        val cfg = args[i + 1]
                        configs.add(cfg)
                        val cfgKey = cfg.substringBefore("=").trim()
                        if (cfgKey.lowercase(Locale.ROOT).startsWith("alias.")) {
                            definesAlias = true
                        }
                        if (isExternalHelperConfigKey(cfgKey)) {
                            hasExternalHelperConfig = true
                            if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                        }
                        i += 2
                        continue
                    } else {
                        isAmbiguousGlobalOptions = true
                        break
                    }
                } else {
                    val cfg = a.removePrefix("-c")
                    configs.add(cfg)
                    val cfgKey = cfg.substringBefore("=").trim()
                    if (cfgKey.lowercase(Locale.ROOT).startsWith("alias.")) {
                        definesAlias = true
                    }
                    if (isExternalHelperConfigKey(cfgKey)) {
                        hasExternalHelperConfig = true
                        if (cfgKey !in externalHelperConfigKeys) externalHelperConfigKeys.add(cfgKey)
                    }
                    i++
                    continue
                }
            }

            // Check --exec-path=...
            if (a.startsWith("--exec-path=")) {
                i++
                continue
            }

            // Check options with separate argument
            if (a in globalOptsWithArg) {
                if (i + 1 < args.size) {
                    i += 2
                    continue
                } else {
                    isAmbiguousGlobalOptions = true
                    break
                }
            }

            // Global flags with glued arguments
            if (a.startsWith("-C") && a.length > 2) {
                i++
                continue
            }

            // Standalone global options
            if (a in standaloneGlobalOpts) {
                if (a == "--version") {
                    hasVersionFlag = true
                }
                i++
                continue
            }

            // Unknown option flags starting with -
            if (a.startsWith("-")) {
                isAmbiguousGlobalOptions = true
                break
            }

            // First non-option argument is the Git subcommand
            subcmd = a.lowercase(Locale.ROOT)
            subArgs = if (i + 1 < args.size) args.subList(i + 1, args.size) else emptyList()
            break
        }

        // Inspect configs for alias definitions
        for (cfg in configs) {
            val key = cfg.substringBefore("=").trim().lowercase(Locale.ROOT)
            if (key.startsWith("alias.")) {
                definesAlias = true
                val valPart = cfg.substringAfter("=", "").trim()
                val valLower = valPart.lowercase(Locale.ROOT)
                val isShell = valPart.startsWith("!")
                val targetFirstWord = valPart.removePrefix("!").trim().split(Regex("\\s+")).firstOrNull()?.lowercase(Locale.ROOT) ?: ""
                val isGitClean = targetFirstWord == "clean"
                val isGitRm = targetFirstWord == "rm" && !valLower.contains("--cached")
                val isDelWord = FILE_DELETION_COMMANDS.any { del -> valLower.contains("\\b$del\\b".toRegex()) || valLower.contains(del) }
                val isBlockedWord = TerminalConfig.DEFAULT_BLOCKED_COMMANDS.any { b -> valLower.contains(b) }
                if (isShell || isGitClean || isGitRm || isDelWord || isBlockedWord) {
                    aliasDefinesShellOrDeletion = true
                }
            }
        }

        // Also check if subcommand is "config" and modifies an alias or external helper
        if (subcmd == "config") {
            val fullConfigArgs = subArgs.joinToString(" ").lowercase(Locale.ROOT)
            if (subArgs.any { it.lowercase(Locale.ROOT).startsWith("alias.") }) {
                definesAlias = true
                val isShell = fullConfigArgs.contains("!")
                val isGitClean = fullConfigArgs.contains("clean")
                val isGitRm = fullConfigArgs.contains("rm") && !fullConfigArgs.contains("--cached")
                val isDelWord = FILE_DELETION_COMMANDS.any { del -> fullConfigArgs.contains("\\b$del\\b".toRegex()) || fullConfigArgs.contains(del) }
                val isBlockedWord = TerminalConfig.DEFAULT_BLOCKED_COMMANDS.any { b -> fullConfigArgs.contains(b) }
                if (isShell || isGitClean || isGitRm || isDelWord || isBlockedWord) {
                    aliasDefinesShellOrDeletion = true
                }
            }
            if (subArgs.any { isExternalHelperConfigKey(it.substringBefore("=")) }) {
                hasExternalHelperConfig = true
                for (a in subArgs) {
                    val k = a.substringBefore("=")
                    if (isExternalHelperConfigKey(k) && k !in externalHelperConfigKeys) {
                        externalHelperConfigKeys.add(k)
                    }
                }
            }
        }

        val category = classifyGitSubcommand(subcmd, subArgs, hasVersionFlag)

        return GitParsedInvocation(
            subcommand = subcmd,
            subcommandArgs = subArgs,
            configs = configs,
            definesAlias = definesAlias,
            aliasDefinesShellOrDeletion = aliasDefinesShellOrDeletion,
            hasOpaqueConfigEnvAlias = hasOpaqueConfigEnvAlias,
            hasExternalHelperConfig = hasExternalHelperConfig,
            externalHelperConfigKeys = externalHelperConfigKeys,
            category = category,
            isAmbiguousGlobalOptions = isAmbiguousGlobalOptions,
        )
    }

    private fun classifyGitSubcommand(
        subcmd: String?,
        subArgs: List<String>,
        hasVersionFlag: Boolean,
    ): GitCategory {
        if (subcmd == null) {
            return if (hasVersionFlag) GitCategory.READ_ONLY else GitCategory.UNKNOWN
        }

        // Check if mutating subcommands
        if (subcmd in MUTATING_GIT_SUBCOMMANDS) {
            // For branch, tag, remote, stash: only specific read-only subcommands/flags are READ_ONLY
            when (subcmd) {
                "branch" -> {
                    val hasDelete = subArgs.any { it == "-d" || it == "-D" || it == "--delete" }
                    if (hasDelete) return GitCategory.MUTATING
                    val isExplicitList = subArgs.any { it == "-l" || it == "--list" }
                    val hasOnlyListFlags = subArgs.all { it.startsWith("-") && it != "-d" && it != "-D" }
                    if (subArgs.isEmpty() || isExplicitList || hasOnlyListFlags) {
                        return GitCategory.READ_ONLY
                    }
                    return GitCategory.MUTATING
                }
                "tag" -> {
                    val hasDelete = subArgs.any { it == "-d" || it == "--delete" }
                    if (hasDelete) return GitCategory.MUTATING
                    val isExplicitList = subArgs.any { it == "-l" || it == "--list" || it == "-n" }
                    val hasOnlyListFlags = subArgs.all { it.startsWith("-") && it != "-d" }
                    if (subArgs.isEmpty() || isExplicitList || hasOnlyListFlags) {
                        return GitCategory.READ_ONLY
                    }
                    return GitCategory.MUTATING
                }
                "remote" -> {
                    val hasMutate = subArgs.any { it in setOf("add", "rename", "remove", "rm", "set-url", "set-head", "prune") }
                    if (hasMutate) return GitCategory.MUTATING
                    val isReadOnly = subArgs.isEmpty() || subArgs.any { it in setOf("-v", "--verbose", "show", "get-url") }
                    if (isReadOnly) return GitCategory.READ_ONLY
                    return GitCategory.MUTATING
                }
                "stash" -> {
                    val isList = subArgs.firstOrNull() in setOf("list", "show")
                    if (isList) return GitCategory.READ_ONLY
                    return GitCategory.MUTATING
                }
                else -> return GitCategory.MUTATING
            }
        }

        if (subcmd in BASE_READ_ONLY_GIT_SUBCOMMANDS) {
            // Check for flags that trigger external diff or textconv
            val hasExtDiff = subArgs.any { it == "--ext-diff" }
            val hasTextconv = subArgs.any { it == "--textconv" }
            val hasOutputFile = subArgs.any { it.startsWith("--output=") || it == "-o" || it == "--output" }
            if (hasExtDiff || hasTextconv || hasOutputFile) {
                return GitCategory.UNKNOWN
            }

            // Check if subcommands have subarguments that mutate
            when (subcmd) {
                "diff" -> {
                    val hasNoIndex = subArgs.any { it == "--no-index" }
                    if (hasNoIndex) return GitCategory.READ_ONLY
                    return GitCategory.READ_ONLY
                }
                else -> return GitCategory.READ_ONLY
            }
        }

        return GitCategory.UNKNOWN
    }

    private data class ParsedCommandChain(
        val effectiveCommand: String,
        val effectiveNormalized: String,
        val effectiveArgs: List<String>,
        val isWrapped: Boolean,
        val wrappers: List<String>,
        val isAmbiguousWrapper: Boolean = false,
    )

    private data class XargsParseResult(
        val target: String?,
        val targetArgs: List<String>,
        val isAmbiguous: Boolean,
    )

    private fun parseXargsArgs(args: List<String>): XargsParseResult {
        if (args.isEmpty()) {
            return XargsParseResult(target = null, targetArgs = emptyList(), isAmbiguous = true)
        }

        val longOptsWithArg = setOf(
            "--max-args", "--max-procs", "--arg-file", "--delimiter", "--eof", "--max-lines", "--max-chars"
        )
        val standaloneLongOpts = setOf(
            "--null", "--interactive", "--no-run-if-empty", "--verbose", "--open-tty", "--exact", "--exit"
        )
        val standaloneShortOpts = setOf('0', 'p', 'r', 't', 'o', 'x')
        val shortOptsWithArg = setOf('d', 'E', 'e', 'I', 'i', 'L', 'l', 'n', 'P', 's', 'a')

        var i = 0
        var isAmbiguous = false

        while (i < args.size) {
            val arg = args[i]

            // End of options marker
            if (arg == "--") {
                i++
                break
            }

            // Long options
            if (arg.startsWith("--")) {
                if (arg.startsWith("--replace=")) {
                    val replacement = arg.substringAfter("=")
                    if (replacement.isEmpty() || replacement == "\"\"" || replacement == "''") {
                        isAmbiguous = true
                        break
                    }
                    i++
                    continue
                }
                if (arg == "--replace") {
                    if (i + 1 < args.size) {
                        val replacement = args[i + 1]
                        if (replacement.isEmpty() || replacement.startsWith("-")) {
                            isAmbiguous = true
                            break
                        }
                        i += 2
                        continue
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                if (arg.contains("=")) {
                    val optName = arg.substringBefore("=")
                    if (optName in longOptsWithArg) {
                        i++
                        continue
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                if (arg in longOptsWithArg) {
                    if (i + 1 < args.size) {
                        i += 2
                        continue
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                if (arg in standaloneLongOpts) {
                    i++
                    continue
                }
                // Unknown long option
                isAmbiguous = true
                break
            }

            // Short options
            if (arg.startsWith("-") && arg.length > 1) {
                var charIdx = 1
                while (charIdx < arg.length) {
                    val c = arg[charIdx]
                    if (c in standaloneShortOpts) {
                        charIdx++
                        continue
                    } else if (c in shortOptsWithArg) {
                        val restOfArg = arg.substring(charIdx + 1)
                        if (restOfArg.isNotEmpty()) {
                            // Argument was glued into this token
                            charIdx = arg.length
                            break
                        } else {
                            // Argument is in the next token
                            if (i + 1 < args.size) {
                                i++ // consume next token as option argument
                                charIdx = arg.length
                                break
                            } else {
                                isAmbiguous = true
                                break
                            }
                        }
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                if (isAmbiguous) break
                i++
                continue
            }

            // First non-option token is the target command
            break
        }

        if (isAmbiguous) {
            return XargsParseResult(target = null, targetArgs = emptyList(), isAmbiguous = true)
        }

        if (i < args.size) {
            val target = args[i]
            val targetArgs = if (i + 1 < args.size) args.subList(i + 1, args.size) else emptyList()
            return XargsParseResult(target = target, targetArgs = targetArgs, isAmbiguous = false)
        }

        // xargs without command defaults to echo, but cannot be verified safe
        return XargsParseResult(target = null, targetArgs = emptyList(), isAmbiguous = true)
    }

    private fun unwrapCommand(rawCommand: String, normalizedName: String, args: List<String>): ParsedCommandChain {
        var curCommand = rawCommand
        var curNormalized = normalizedName
        var curArgs = args
        val wrappers = mutableListOf<String>()
        var isAmbiguousWrapper = false

        while (curNormalized in WRAPPER_COMMANDS) {
            wrappers.add(curNormalized)
            if (curNormalized == "xargs") {
                val parsedXargs = parseXargsArgs(curArgs)
                if (parsedXargs.isAmbiguous || parsedXargs.target == null) {
                    isAmbiguousWrapper = true
                    break
                }
                curCommand = parsedXargs.target
                curArgs = parsedXargs.targetArgs
                val isWin = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
                val name = Path.of(curCommand.replace('\\', '/')).fileName?.toString() ?: curCommand
                curNormalized = if (isWin) {
                    name.lowercase(Locale.ROOT).removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
                } else {
                    name.lowercase(Locale.ROOT)
                }
                continue
            }

            val next = findWrappedTarget(curNormalized, curArgs)
            if (next == null) {
                isAmbiguousWrapper = true
                break
            }
            curCommand = next.first
            curArgs = next.second
            val isWin = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
            val name = Path.of(curCommand.replace('\\', '/')).fileName?.toString() ?: curCommand
            curNormalized = if (isWin) {
                name.lowercase(Locale.ROOT).removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
            } else {
                name.lowercase(Locale.ROOT)
            }
        }

        return ParsedCommandChain(
            effectiveCommand = curCommand,
            effectiveNormalized = curNormalized,
            effectiveArgs = curArgs,
            isWrapped = wrappers.isNotEmpty(),
            wrappers = wrappers,
            isAmbiguousWrapper = isAmbiguousWrapper,
        )
    }

    private fun findWrappedTarget(wrapper: String, args: List<String>): Pair<String, List<String>>? {
        if (args.isEmpty()) return null
        var i = 0

        when (wrapper) {
            "xargs" -> {
                val parsed = parseXargsArgs(args)
                if (parsed.isAmbiguous || parsed.target == null) {
                    return null
                }
                return Pair(parsed.target, parsed.targetArgs)
            }
            "sudo", "doas", "pkexec" -> {
                val optsWithArg = setOf("-u", "-g", "-p", "-c", "-C", "-r", "-t", "--user")
                while (i < args.size) {
                    val a = args[i]
                    if (a == "--") {
                        i++
                        break
                    }
                    if (a in optsWithArg) {
                        i += 2
                        continue
                    }
                    if (a.startsWith("-")) {
                        i++
                        continue
                    }
                    break
                }
            }
            "env" -> {
                val optsWithArg = setOf("-u", "--unset", "-C", "--chdir", "-S", "--split-string")
                while (i < args.size) {
                    val a = args[i]
                    if (a == "--") {
                        i++
                        break
                    }
                    if (a in optsWithArg) {
                        i += 2
                        continue
                    }
                    if (a.startsWith("-")) {
                        i++
                        continue
                    }
                    // Skip VAR=val environment assignments
                    if (a.contains("=") && !a.startsWith("=")) {
                        i++
                        continue
                    }
                    break
                }
            }
            "busybox" -> {
                while (i < args.size) {
                    val a = args[i]
                    if (a.startsWith("-")) {
                        i++
                        continue
                    }
                    break
                }
            }
            "nohup" -> {
                while (i < args.size) {
                    val a = args[i]
                    if (a == "--") {
                        i++
                        break
                    }
                    if (a.startsWith("-")) {
                        i++
                        continue
                    }
                    break
                }
            }
            "su" -> {
                val optsWithArg = setOf("-c", "-s")
                while (i < args.size) {
                    val a = args[i]
                    if (a in optsWithArg) {
                        if (a == "-c" && i + 1 < args.size) {
                            val cmdString = args[i + 1]
                            val parts = cmdString.trim().split(Regex("\\s+"))
                            if (parts.isNotEmpty()) {
                                return Pair(parts[0], parts.drop(1))
                            }
                        }
                        i += 2
                        continue
                    }
                    if (a.startsWith("-")) {
                        i++
                        continue
                    }
                    // username
                    i++
                    break
                }
            }
            else -> {
                while (i < args.size && args[i].startsWith("-")) {
                    i++
                }
            }
        }

        if (i < args.size) {
            val target = args[i]
            val targetArgs = if (i + 1 < args.size) args.subList(i + 1, args.size) else emptyList()
            return Pair(target, targetArgs)
        }
        return null
    }

    private fun isTerminalDeletionCommand(
        normalizedName: String,
        cmd: TerminalCommand,
        shellTokens: Set<String> = emptySet(),
        parsedGit: GitParsedInvocation? = null,
    ): Boolean {
        if (normalizedName in FILE_DELETION_COMMANDS) return true
        if (normalizedName == "git") {
            val git = parsedGit ?: parseGitArgs(cmd.args)
            if (git.subcommand == "clean") return true
            if (git.subcommand == "rm") {
                val hasCached = git.subcommandArgs.any { it == "--cached" }
                if (!hasCached) return true
            }
            if (git.aliasDefinesShellOrDeletion) return true
            if (git.hasOpaqueConfigEnvAlias) return true
            for (cfg in git.configs) {
                val valPart = cfg.substringAfter("=", "").lowercase(Locale.ROOT)
                val targetFirstWord = valPart.removePrefix("!").trim().split(Regex("\\s+")).firstOrNull() ?: ""
                val isGitClean = targetFirstWord == "clean"
                val isGitRm = targetFirstWord == "rm" && !valPart.contains("--cached")
                val isDelWord = FILE_DELETION_COMMANDS.any { del -> valPart.contains("\\b$del\\b".toRegex()) || valPart.contains(del) }
                if (isGitClean || isGitRm || isDelWord) {
                    return true
                }
            }
        }
        if (normalizedName in SHELL_LAUNCHERS) {
            if (FILE_DELETION_COMMANDS.any { it in shellTokens }) {
                return true
            }
            val fullArgs = cmd.args.joinToString(" ").lowercase(Locale.ROOT)
            if (FILE_DELETION_COMMANDS.any { del -> fullArgs.contains("\\b$del\\b".toRegex()) || fullArgs.contains(del) }) {
                return true
            }
        }
        return false
    }

    private fun isDestructiveGitCommand(
        normalizedName: String,
        cmd: TerminalCommand,
        parsedGit: GitParsedInvocation = parseGitArgs(cmd.args),
    ): Boolean {
        if (normalizedName != "git") return false
        val subcmd = parsedGit.subcommand ?: return false
        if (subcmd in DESTRUCTIVE_GIT_SUBCOMMANDS) return true
        if (subcmd == "rm") {
            val hasCached = parsedGit.subcommandArgs.any { it == "--cached" }
            if (!hasCached) return true
        }
        if (subcmd == "checkout") {
            if (parsedGit.subcommandArgs.any { it == "-f" || it == "--force" || it == "-B" || it == "--discard-changes" }) return true
        }
        if (subcmd == "switch") {
            if (parsedGit.subcommandArgs.any { it == "-f" || it == "--force" || it == "-C" || it == "--discard-changes" }) return true
        }
        if (subcmd == "restore") {
            if (parsedGit.subcommandArgs.any { it == "--staged" || it == "--worktree" }) return true
        }
        if (subcmd == "branch") {
            if (parsedGit.subcommandArgs.any { it == "-D" || it == "-d" || it == "--delete" }) return true
        }
        return false
    }
