                return GitCategory.MUTATING
            }

            val listFlagsWithArg = setOf(
                "--contains", "--no-contains", "--merged", "--no-merged", "--sort", "--format", "--points-at"
            )
            val listStandaloneFlags = setOf(
                "-a", "--all", "-r", "--remotes", "-v", "-vv", "--verbose", "-l", "--list",
                "--show-current", "-i", "--ignore-case", "-q", "--quiet", "--no-color", "--color",
                "--column", "--no-column"
            )
            val hasListFlag = subArgs.any { it == "-l" || it == "--list" }

            var i = 0
            while (i < subArgs.size) {
                val a = subArgs[i]
                if (a in listStandaloneFlags) {
                    i++
                    continue
                }
                if (a in listFlagsWithArg) {
                    i += 2
                    continue
                }
                if (listFlagsWithArg.any { f -> a.startsWith("$f=") }) {
                    i++
                    continue
                }
                if (!a.startsWith("-")) {
                    // If listing flag is present, positional arg is a pattern; otherwise it is a branch to create/modify
                    if (hasListFlag) {
                        i++
                        continue
                    }
                    return GitCategory.MUTATING
                }
                return GitCategory.MUTATING
            }
            return GitCategory.READ_ONLY
        }

        if (subcmd == "tag") {
            val mutatingTagFlags = setOf(
                "-d", "--delete", "-a", "-s", "-u", "-f", "--force", "-m", "-F"
            )
            if (subArgs.any { it in mutatingTagFlags || mutatingTagFlags.any { f -> it.startsWith("$f=") } }) {
                return GitCategory.MUTATING
            }

            val listTagFlagsWithArg = setOf(
                "-n", "--sort", "--contains", "--no-contains", "--points-at", "--format"
            )
            val listTagStandaloneFlags = setOf(
                "-l", "--list", "-v", "--verify", "-i", "--ignore-case", "--column", "--no-column"
            )
            val hasListFlag = subArgs.any { it == "-l" || it == "--list" }
            val hasVerifyFlag = subArgs.any { it == "-v" || it == "--verify" }

            var i = 0
            while (i < subArgs.size) {
                val a = subArgs[i]
                if (a in listTagStandaloneFlags) {
                    i++
                    continue
                }
                if (a in listTagFlagsWithArg) {
                    i += 2
                    continue
                }
                if (listTagFlagsWithArg.any { f -> a.startsWith("$f=") } || a.startsWith("-n")) {
                    i++
                    continue
                }
                if (!a.startsWith("-")) {
                    if (hasListFlag || hasVerifyFlag) {
                        i++
                        continue
                    }
                    // Positional argument without list/verify: creating a tag!
                    return GitCategory.MUTATING
                }
                return GitCategory.MUTATING
            }
            return GitCategory.READ_ONLY
        }

        if (subcmd == "remote") {
            val mutatingRemoteSubs = setOf(
                "add", "rename", "remove", "rm", "set-head", "set-branches", "set-url", "prune", "update"
            )
            val readOnlyRemoteSubs = setOf(
                "show", "get-url"
            )
            val nonFlagArgs = subArgs.filter { !it.startsWith("-") }
            if (nonFlagArgs.isEmpty()) {
                return GitCategory.READ_ONLY
            }
            val remoteSub = nonFlagArgs[0].lowercase(Locale.ROOT)
            if (remoteSub in mutatingRemoteSubs) {
                return GitCategory.MUTATING
            }
            if (remoteSub in readOnlyRemoteSubs) {
                return GitCategory.READ_ONLY
            }
            return GitCategory.MUTATING
        }

        if (subcmd in MUTATING_GIT_SUBCOMMANDS) {
            return GitCategory.MUTATING
        }

        return GitCategory.UNKNOWN
    }

    private fun parseXargsArgs(args: List<String>): XargsParseResult {
        if (args.isEmpty()) {
            return XargsParseResult(target = null, targetArgs = emptyList(), isAmbiguous = true)
        }

        val longOptsWithArg = setOf(
            "--max-args", "--max-procs", "--arg-file", "--delimiter", "--eof", "--max-lines", "--max-chars"
        )
        val standaloneLongOpts = setOf(
            "--null", "--interactive", "--no-run-if-empty", "--verbose", "--open-tty", "--exact", "--exit"
        )
        val standaloneShortOpts = setOf('0', 'p', 'r', 't', 'o', 'x')
        val shortOptsWithArg = setOf('d', 'E', 'e', 'I', 'i', 'L', 'l', 'n', 'P', 's', 'a')

        var i = 0
        var isAmbiguous = false

        while (i < args.size) {
            val arg = args[i]

            // End of options marker
            if (arg == "--") {
                i++
                break
            }

            // Long options
            if (arg.startsWith("--")) {
                if (arg.startsWith("--replace=")) {
                    i++
                    continue
                }
                if (arg == "--replace") {
                    i++
                    continue
                }
                if (arg.contains("=")) {
                    val optName = arg.substringBefore("=")
                    if (optName in longOptsWithArg) {
                        i++
                        continue
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                if (arg in standaloneLongOpts) {
                    i++
                    continue
                }
                if (arg in longOptsWithArg) {
                    if (i + 1 < args.size) {
                        i += 2
                        continue
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                isAmbiguous = true
                break
            }

            // Short options
            if (arg.startsWith("-") && arg.length > 1) {
                var c = 1
                while (c < arg.length) {
                    val ch = arg[c]
                    if (ch in standaloneShortOpts) {
                        c++
                    } else if (ch in shortOptsWithArg) {
                        val rest = arg.substring(c + 1)
                        if (rest.isNotEmpty()) {
                            // Value is embedded in same argument: e.g. -I{}, -P4, -n1
                            c = arg.length
                        } else {
                            if (ch == 'i' || ch == 'e') {
                                // -i and -e can be standalone in POSIX/GNU xargs
                                c = arg.length
                            } else {
                                if (i + 1 < args.size) {
                                    i++
                                    c = arg.length
                                } else {
                                    isAmbiguous = true
                                    break
                                }
                            }
                        }
                    } else {
                        isAmbiguous = true
                        break
                    }
                }
                if (isAmbiguous) break
                i++
                continue
            }

            // First non-option token is the target command
            break
        }

        if (isAmbiguous) {
            return XargsParseResult(target = null, targetArgs = emptyList(), isAmbiguous = true)
        }

        if (i < args.size) {
            val target = args[i]
            val targetArgs = if (i + 1 < args.size) args.subList(i + 1, args.size) else emptyList()
            return XargsParseResult(target = target, targetArgs = targetArgs, isAmbiguous = false)
        }

        // xargs without command defaults to echo, but cannot be verified safe
        return XargsParseResult(target = null, targetArgs = emptyList(), isAmbiguous = true)
    }

    private fun unwrapCommand(rawCommand: String, normalizedName: String, args: List<String>): ParsedCommandChain {
        var curCommand = rawCommand
        var curNormalized = normalizedName
        var curArgs = args
        val wrappers = mutableListOf<String>()
        var isAmbiguousWrapper = false

        while (curNormalized in WRAPPER_COMMANDS) {
            wrappers.add(curNormalized)
            if (curNormalized == "xargs") {
                val parsedXargs = parseXargsArgs(curArgs)
                if (parsedXargs.isAmbiguous || parsedXargs.target == null) {
                    isAmbiguousWrapper = true
                    break
                }
                curCommand = parsedXargs.target
                curArgs = parsedXargs.targetArgs
                val isWin = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
                val name = Path.of(curCommand.replace('\\', '/')).fileName?.toString() ?: curCommand
                curNormalized = if (isWin) {
                    name.lowercase(Locale.ROOT).removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
                } else {
                    name.lowercase(Locale.ROOT)
                }
                continue
            }

            val next = findWrappedTarget(curNormalized, curArgs)
            if (next == null) {
                isAmbiguousWrapper = true
                break
            }
            curCommand = next.first
            curArgs = next.second
            val isWin = System.getProperty("os.name")?.lowercase(Locale.ROOT)?.contains("win") == true
            val name = Path.of(curCommand.replace('\\', '/')).fileName?.toString() ?: curCommand
            curNormalized = if (isWin) {
                name.lowercase(Locale.ROOT).removeSuffix(".exe").removeSuffix(".cmd").removeSuffix(".bat")
            } else {
                name.lowercase(Locale.ROOT)
            }
        }

        return ParsedCommandChain(
            effectiveCommand = curCommand,
            effectiveNormalized = curNormalized,
            effectiveArgs = curArgs,
            isWrapped = wrappers.isNotEmpty(),
            wrappers = wrappers,
            isAmbiguousWrapper = isAmbiguousWrapper,
        )
    }

    private fun findWrappedTarget(wrapper: String, args: List<String>): Pair<String, List<String>>? {
