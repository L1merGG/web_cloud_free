    internal fun parseGitConfigFile(
        file: Path,
        visited: MutableSet<Path> = mutableSetOf(),
        depth: Int = 0,
    ): Pair<Map<String, String>, Boolean> {
        if (!Files.isRegularFile(file)) return Pair(emptyMap(), false)
        val norm = file.toAbsolutePath().normalize()
        if (norm in visited) return Pair(emptyMap(), false)
        visited.add(norm)
        return try {
            val content = Files.readString(norm)
            parseGitConfigContent(content, norm.parent, visited, depth)
        } catch (_: Exception) {
            Pair(emptyMap(), true)
        }
    }

    internal fun findAndParseGitConfig(startDir: Path, workspaceRoot: Path): Pair<Map<String, String>, Boolean> {
        var curr: Path? = startDir
        val merged = mutableMapOf<String, String>()
        var hasUnres = false

        while (curr != null) {
            val dotGit = curr.resolve(".git")
            if (Files.isDirectory(dotGit)) {
                val configFile = dotGit.resolve("config")
                if (Files.isRegularFile(configFile)) {
                    val (entries, unres) = parseGitConfigFile(configFile)
                    merged.putAll(entries)
                    if (unres) hasUnres = true
                }
                val worktreeConfigFile = dotGit.resolve("config.worktree")
                if (Files.isRegularFile(worktreeConfigFile)) {
                    val (entries, unres) = parseGitConfigFile(worktreeConfigFile)
                    merged.putAll(entries)
                    if (unres) hasUnres = true
                }
                return Pair(merged, hasUnres)
            } else if (Files.isRegularFile(dotGit)) {
                try {
                    val line = Files.readAllLines(dotGit).firstOrNull()?.trim() ?: ""
                    if (line.startsWith("gitdir:")) {
                        val gitDirStr = line.removePrefix("gitdir:").trim()
                        val gitDirPath = curr.resolve(gitDirStr).normalize()
                        val configFile = gitDirPath.resolve("config")
                        if (Files.isRegularFile(configFile)) {
                            val (entries, unres) = parseGitConfigFile(configFile)
                            merged.putAll(entries)
                            if (unres) hasUnres = true
                        }
                        val worktreeConfig = gitDirPath.resolve("config.worktree")
                        if (Files.isRegularFile(worktreeConfig)) {
                            val (entries, unres) = parseGitConfigFile(worktreeConfig)
                            merged.putAll(entries)
                            if (unres) hasUnres = true
                        }
                        val commonDirFile = gitDirPath.resolve("commondir")
                        if (Files.isRegularFile(commonDirFile)) {
                            val commonDirStr = Files.readString(commonDirFile).trim()
                            val commonDirPath = gitDirPath.resolve(commonDirStr).normalize()
                            val commonConfig = commonDirPath.resolve("config")
                            if (Files.isRegularFile(commonConfig)) {
                                val (entries, unres) = parseGitConfigFile(commonConfig)
                                merged.putAll(entries)
                                if (unres) hasUnres = true
                            }
                        }
                        return Pair(merged, hasUnres)
                    }
                } catch (_: Exception) {
                    return Pair(emptyMap(), true)
                }
            }
            if (curr == workspaceRoot || curr.parent == null) break
            curr = curr.parent
        }
        return Pair(emptyMap(), false)
    }

